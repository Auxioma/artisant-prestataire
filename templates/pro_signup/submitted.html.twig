{#- A03.7 — écran de suivi du dossier (Figma 230:12384), selon le statut RG-043 : en attente (délai annoncé, crédits offerts RG-044), complément demandé, vérifié, refusé (motif), suspendu. Jauge de complétude PR08.1. -#}
{% extends 'base.html.twig' %}
{% set header_variant = 'tunnel' %}

{% block title %}Votre dossier — Inscription professionnelle — TrouveMoi{% endblock %}

{% block body %}
{% set status = state.status %}
{% set more_info = status == 'pending_verification' and state.statusReason == 'more_info' %}
{% set heading = {
    pending_verification: more_info ? 'Un complément est demandé pour votre dossier' : 'Votre dossier est en cours de vérification',
    verified: state.hiddenReason ? 'Votre profil est masqué' : 'Votre compte professionnel est vérifié',
    rejected: 'Votre dossier n’a pas été retenu',
    suspended: 'Votre compte professionnel est suspendu',
}[status] ?? 'Votre dossier' %}
{% set tone = state.hiddenReason ? 'danger' : ({verified: 'success', rejected: 'danger', suspended: 'danger'}[status] ?? (more_info ? 'info' : 'success')) %}
{% set item_labels = {
    logo: 'Logo ou photo', description: 'Description', photos: photos_target ~ ' photos de réalisations', hours: 'Horaires d’ouverture',
    zone: 'Zone d’intervention', services: 'Prestations', labels: 'Labels et qualifications',
} %}
{% set item_links = state.status in ['incomplete', 'pending_verification'] ? {logo: path('artisan_signup_profile'), description: path('artisan_signup_profile'), zone: path('artisan_signup_area'), labels: path('artisan_signup_insurance')} : {zone: path('artisan_signup_area')} %}
<div class="tm-auth-page tm-pro-signup">
    <div class="tm-container tm-submitted__page">
    {% if track_completed %}<div hidden data-controller="analytics" data-analytics-auto-event-value="pro_signup_completed"></div>{% endif %}
    <section class="tm-card-panel tm-state-card tm-submitted" aria-labelledby="dossier-titre">
        <span class="tm-state-card__icon tm-state-card__icon--{{ tone }}"><twig:Icon name="{{ tone == 'danger' ? 'alert' : (tone == 'info' ? 'info' : 'check') }}" /></span>
        <h1 id="dossier-titre" class="tm-state-card__title">{{ heading }}</h1>

        {% if status == 'pending_verification' %}
            {% if more_info %}
                <div class="tm-submitted__notice" role="status"><twig:Icon name="info" size="sm" class="tm-icon--inherit" /><p><strong>Message de notre équipe :</strong> {{ state.statusComment }}</p></div>
            {% else %}
                <p><twig:Badge variant="pending">Délai annoncé : {{ delay_hours }} h ouvrées</twig:Badge></p>
            {% endif %}
            <p class="tm-submitted__credits"><twig:Icon name="tag" size="sm" class="tm-icon--inherit" />{{ free_credits }} devis offerts dès la validation de votre compte</p>
        {% elseif status == 'verified' and state.hiddenReason %}
            <div class="tm-form-alert" role="alert"><twig:Icon name="alert" size="sm" class="tm-icon--inherit" /><p><strong>Profil masqué :</strong> {{ state.hiddenReason }}. Il n’est plus visible des clients et ne reçoit plus de demandes.</p></div>
            <p>Mettez à jour vos <a href="{{ path('artisan_signup_insurance') }}">assurances</a> et déposez les nouvelles attestations : votre profil réapparaîtra dès leur validation.</p>
        {% elseif status == 'verified' %}
            <p>Votre profil est visible des clients et vous recevez les demandes de votre zone.</p>
            {% set credits = tm_artisan_credits() %}
            {% if credits %}<p class="tm-submitted__credits"><twig:Icon name="tag" size="sm" class="tm-icon--inherit" />{{ credits.remaining|number_format(0, ',', ' ') }} devis disponibles sur votre compte</p>{% endif %}
        {% elseif status == 'rejected' %}
            <div class="tm-form-alert" role="alert"><twig:Icon name="alert" size="sm" class="tm-icon--inherit" /><p><strong>Motif :</strong> {{ rejection_label ?? 'non précisé' }}{% if state.statusComment %} — {{ state.statusComment }}{% endif %}</p></div>
            <p>Vous pensez qu’il s’agit d’une erreur ? <a href="{{ tm_path('content_contact') }}">Contactez-nous</a> pour faire réexaminer votre dossier.</p>
        {% elseif status == 'suspended' %}
            <div class="tm-form-alert" role="alert"><twig:Icon name="alert" size="sm" class="tm-icon--inherit" /><p><strong>Motif :</strong> {{ state.statusComment }}</p></div>
            <p>Votre profil n’est plus visible et vous ne recevez plus de demandes. <a href="{{ tm_path('content_contact') }}">Contactez-nous</a> pour en savoir plus.</p>
        {% endif %}

        {% if status in ['pending_verification', 'verified'] %}
        <div class="tm-submitted__checklist">
            <h2 class="tm-card-title">Votre dossier</h2>
            <ul class="tm-check-list">
                <li><twig:Icon name="check" size="xs" />Entreprise, métiers et zone d’intervention</li>
                <li><twig:Icon name="check" size="xs" />Assurances et qualifications déclarées</li>
                {% for slot in missing %}
                    <li class="tm-check-list__todo"><twig:Icon name="plus" size="xs" /><a href="{{ path('artisan_signup_documents', {piece: slot.slotKey}) }}">{{ slot.label }}</a></li>
                {% else %}
                    <li><twig:Icon name="check" size="xs" />Justificatifs déposés</li>
                {% endfor %}
            </ul>
            {% if missing is not empty and status == 'pending_verification' %}<p class="tm-caption">La vérification commencera dès réception des pièces manquantes.</p>{% endif %}
        </div>

        {% if completion %}
        <div class="tm-submitted__checklist">
            <h2 class="tm-card-title" id="completude-titre">Complétez votre profil ({{ completion.percent }} %)</h2>
            <progress class="tm-completion" max="100" value="{{ completion.percent }}" aria-labelledby="completude-titre">{{ completion.percent }} %</progress>
            <ul class="tm-check-list">
                {% for item, label in item_labels %}
                    {% if completion.isDone(item) %}
                        <li><twig:Icon name="check" size="xs" />{{ label }}</li>
                    {% elseif item_links[item] is defined %}
                        <li class="tm-check-list__todo"><twig:Icon name="plus" size="xs" /><a href="{{ item_links[item] }}">{{ label }}</a></li>
                    {% else %}
                        <li class="tm-check-list__todo"><twig:Icon name="plus" size="xs" />{{ label }} <span class="tm-caption">(dans votre espace pro, bientôt disponible)</span></li>
                    {% endif %}
                {% endfor %}
            </ul>
            <p class="tm-caption">Un profil complet à {{ tm_setting_int('pro.min_completion_featured') }} % ou plus peut être mis en avant sur la plateforme.</p>
        </div>
        {% endif %}
        {% endif %}

        <p class="tm-submitted__info"><twig:Icon name="info" size="sm" class="tm-icon--inherit" />{{ status == 'pending_verification' ? 'Vous recevrez un e-mail dès la décision. ' }}Votre espace pro ouvre avec une prochaine version de la plateforme.</p>
        {% if status in ['pending_verification', 'verified'] %}
            <div class="tm-pro-signup__actions-end">
                <twig:Button href="{{ path('artisan_signup_documents') }}" variant="secondary">Gérer mes justificatifs</twig:Button>
                <twig:Button href="{{ path('artisan_signup_area') }}" variant="secondary">Modifier ma zone</twig:Button>
                {% if status == 'verified' %}<twig:Button href="{{ path('artisan_signup_insurance') }}" variant="secondary">Mettre à jour mes assurances</twig:Button>{% endif %}
            </div>
        {% endif %}
    </section>
    </div>
</div>
{% endblock %}
