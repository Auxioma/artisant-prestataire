{#-
    PR12 — Souscrire un forfait (Figma 17:2) : « Informations de facturation » (pré-remplies, modifiables, n° de TVA
    vérifié par VIES), « Moyen de paiement » (interface Stripe sécurisée : Stripe Checkout), « Résumé de votre choix »
    (formule, périodicité, montant HT, TVA, total TTC, premier prélèvement, crédits inclus, résiliation), « Code promo et
    conditions » (code appliqué sans JavaScript, CGV professionnelles obligatoires). Rien n'est activé au retour : seul
    le webhook de paiement active l'abonnement (PR12.3). Écarts : P-96.
-#}
{% extends 'pro/_space.html.twig' %}
{% set space_active = 'subscription' %}
{% block title %}Souscrire un forfait — Espace pro — TrouveMoi{% endblock %}
{% set p = preview.plan %}
{% set periods = {mois: 'Mensuelle', an: 'Annuelle'} %}
{% block space_content %}
<div class="tm-psub tm-subscribe">
    <header class="tm-subscribe__head">
        <h1>Souscrire un forfait</h1>
        <p>Finalisez votre abonnement via un paiement sécurisé. Les montants et la TVA proviennent des paramètres de la formule et de votre situation fiscale.</p>
    </header>

    {% if cancelled %}
        <p class="tm-subscribe__notice" role="status"><twig:Icon name="info" size="sm" class="tm-icon--inherit" />Paiement abandonné : rien n’a été débité. Vous pouvez reprendre quand vous le souhaitez.</p>
    {% endif %}
    {% if errors.form is defined %}
        <p class="tm-subscribe__notice is-error" role="alert"><twig:Icon name="alert" size="sm" class="tm-icon--inherit" />{{ errors.form }}</p>
    {% endif %}
    {% if not preview.paymentOpen %}
        <p class="tm-subscribe__notice" role="status"><twig:Icon name="info" size="sm" class="tm-icon--inherit" />Le paiement en ligne n’est pas encore ouvert : vous pourrez confirmer votre abonnement très bientôt.</p>
    {% endif %}

    <form method="post" action="{{ path('pro_subscribe', query) }}" class="tm-subscribe__form" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('pro_subscribe') }}">
        <input type="hidden" name="attempt" value="{{ attempt }}">
        <div class="tm-subscribe__grid">
            <section class="tm-pro-card tm-subscribe__billing" aria-labelledby="facturation-titre">
                <h2 id="facturation-titre" class="tm-subscribe__title">Informations de facturation</h2>
                {% if errors.billing is defined %}<p class="tm-subscribe__error" role="alert">{{ errors.billing }}</p>{% endif %}
                <twig:Field id="company_name" name="company_name" label="Nom de l’entreprise" value="{{ values.company_name }}" autocomplete="organization" maxlength="120" required />
                <twig:Field id="street" name="street" label="Adresse de facturation" value="{{ values.street }}" autocomplete="address-line1" maxlength="200" required />
                <div class="tm-subscribe__pair">
                    <twig:Field id="postal_code" name="postal_code" label="Code postal" value="{{ values.postal_code }}" autocomplete="postal-code" maxlength="10" required />
                    <twig:Field id="city" name="city" label="Ville" value="{{ values.city }}" autocomplete="address-level2" maxlength="100" required />
                </div>
                <div class="tm-field">
                    <label class="tm-field__label" for="country">Pays<abbr class="tm-field__required" title="obligatoire">*</abbr></label>
                    <div class="tm-select">
                        <select class="tm-select__input" id="country" name="country" autocomplete="country">
                            {% for code, name in countries %}<option value="{{ code }}"{{ values.country == code ? ' selected' }}>{{ name }}</option>{% endfor %}
                        </select>
                        <twig:Icon name="chevD" size="xs" class="tm-select__chevron" />
                    </div>
                </div>
                <twig:Field id="vat_number" name="vat_number" label="Numéro de TVA si applicable" value="{{ values.vat_number }}" placeholder="FR12345678901" maxlength="20" help="Vérifié auprès du service européen VIES. Hors de France, un numéro valide permet l’autoliquidation de la TVA." error="{{ errors.vat ?? null }}" />

                <h2 class="tm-subscribe__title">Moyen de paiement</h2>
                <div class="tm-subscribe__stripe">
                    <p><strong>Paiement carte — interface Stripe sécurisée</strong></p>
                    <p>Vous saisirez votre carte bancaire (3-D Secure) ou votre IBAN (prélèvement SEPA) sur la page de paiement sécurisée de Stripe, à l’étape suivante.</p>
                </div>
                <twig:Button type="submit" name="action" value="pay" block icon="lock" iconPosition="start" disabled="{{ not preview.paymentOpen }}">Confirmer l’abonnement</twig:Button>
            </section>

            <section class="tm-pro-card tm-subscribe__summary" aria-labelledby="resume-titre">
                <h2 id="resume-titre" class="tm-subscribe__title">Résumé de votre choix</h2>
                <dl class="tm-subscribe__recap">
                    <div><dt>Formule sélectionnée</dt><dd>{{ p.terms.name }}</dd></div>
                    <div>
                        <dt>Périodicité</dt>
                        <dd>{{ periods[query.periode] }}
                            {% if preview.hasYearly() %}
                                {% set other = query.periode == 'mois' ? 'an' : 'mois' %}
                                <a href="{{ path('pro_subscribe', query|merge({periode: other})) }}">Passer en {{ other == 'an' ? 'annuel' : 'mensuel' }}</a>
                            {% endif %}
                        </dd>
                    </div>
                    <div><dt>Montant HT</dt><dd>{{ preview.priceCents|tm_money }} / {{ query.periode == 'an' ? 'an' : 'mois' }}{% if promotion %}<span class="tm-subscribe__promo-ok">{{ promotion.label }} (code {{ promotion.code }})</span>{% endif %}</dd></div>
                    <div><dt>TVA</dt><dd>Selon situation fiscale<span>20 % en France ; autoliquidation pour une entreprise de l’Union avec un n° de TVA valide</span></dd></div>
                    <div><dt>Total TTC</dt><dd>Calculé à la souscription<span>Affiché sur la page de paiement avant validation</span></dd></div>
                    <div><dt>Premier prélèvement</dt><dd>Aujourd’hui, à la validation du paiement</dd></div>
                    <div><dt>Crédits inclus</dt><dd>{{ p.terms.unlimited ? 'Devis illimités (usage raisonnable)' : p.terms.quotesPerPeriod ~ ' devis par période' }}</dd></div>
                </dl>
                <ul class="tm-subscribe__assurances">
                    <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />Paiement chiffré</li>
                    <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />Facture disponible après validation</li>
                    <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />Aucun numéro de carte stocké par TrouveMoi</li>
                    <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />Sans engagement : résiliation sans frais, effective en fin de période payée</li>
                </ul>
            </section>
        </div>

        <section class="tm-pro-card tm-subscribe__terms" aria-labelledby="conditions-titre">
            <h2 id="conditions-titre" class="tm-subscribe__title">Code promo et conditions</h2>
            <div class="tm-subscribe__promo">
                <twig:Field id="promo" name="promo" label="Code promo" value="{{ promo }}" maxlength="40" autocomplete="off" error="{{ errors.promo ?? null }}" success="{{ promotion ? promotion.label ~ ' appliqué' : null }}" />
                <twig:Button type="submit" name="action" value="apply" variant="secondary">Appliquer</twig:Button>
            </div>
            <label class="tm-check{{ errors.terms is defined ? ' is-invalid' }}" for="cgv">
                <input class="tm-check__input" type="checkbox" id="cgv" name="cgv" value="1"{{ cgv ? ' checked' }}{% if errors.terms is defined %} aria-invalid="true" aria-describedby="cgv_error"{% endif %}>
                <span>J’accepte les <a href="{{ path('identity_legal_document', {slug: 'cgv-professionnels'}) }}" target="_blank" rel="noopener">CGV professionnelles<span class="tm-visually-hidden"> (nouvel onglet)</span></a> (obligatoire)</span>
            </label>
            {% if errors.terms is defined %}<p id="cgv_error" class="tm-subscribe__error" role="alert">{{ errors.terms }}</p>{% endif %}
            <p class="tm-psub__note">Aucune donnée de carte ne transite par nos serveurs (Stripe Checkout, 3-D Secure). Le mandat de prélèvement SEPA, si vous choisissez ce mode, est accepté sur la page de paiement. Les crédits sont activés à la confirmation du paiement.</p>
        </section>
    </form>
</div>
{% endblock %}
