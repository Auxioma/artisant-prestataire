{#-
    PR11 — Mes abonnements (Figma 167:1401) : en-tête (« Comparer les formules », « Changer de formule »), onglets,
    « Mon abonnement actuel » (forfait, statut, prix HT, prochain prélèvement, fin de période, période en cours) ou offre
    de lancement, « Inclus dans ma formule », « Mes options activées », « Nos formules d'abonnement » (PR11.4, forfait
    actuel signalé), « Mes factures récentes » et « Mon moyen de paiement » (T-605), onglet « Historique » (PR11.2,
    registre RG-107). Écarts : P-95.
-#}
{% extends 'pro/_space.html.twig' %}
{% set space_active = 'subscription' %}
{% block title %}Mes abonnements — Espace pro — TrouveMoi{% endblock %}
{% set intervals = {month: 'mois', year: 'an'} %}
{% set status_class = {active: 'is-ok', incomplete: 'is-todo', past_due: 'is-urgent', suspended: 'is-urgent', cancelled: 'is-muted'} %}
{% block space_content %}
<div class="tm-psub">
    <header class="tm-psub__head">
        <div class="tm-pro-head">
            <span class="tm-pro-head__picto" aria-hidden="true"><twig:Icon name="receipt" class="tm-icon--inherit" /></span>
            <div>
                <h1>Mes abonnements</h1>
                <p>Gérez votre formule, suivez vos paiements et faites évoluer votre abonnement.</p>
            </div>
        </div>
        {% if view %}
            <div class="tm-psub__actions">
                <twig:Button href="{{ path('pro_subscription') }}#formules" variant="secondary" icon="grid" iconPosition="start">Comparer les formules</twig:Button>
                <twig:Button href="{{ path('pro_subscription') }}#formules" icon="refresh" iconPosition="start">{{ view.subscription ? 'Changer de formule' : 'Choisir une formule' }}</twig:Button>
            </div>
        {% endif %}
    </header>

    {% if view is null %}
        <twig:EmptyState title="Votre abonnement s’ouvre avec votre dossier vérifié" text="Une fois votre compte professionnel vérifié, vous recevez vos devis gratuits et pouvez choisir une formule." icon="shield">
            <twig:Button href="{{ path('content_pricing') }}" variant="secondary">Voir les formules</twig:Button>
        </twig:EmptyState>
    {% else %}
        {% set base = path('pro_subscription') %}
        <nav class="tm-pro-tabs tm-psub__tabs" aria-label="Rubriques de l’abonnement">
            <a href="{{ base }}"{% if tab == 'abonnement' %} aria-current="page"{% endif %}><twig:Icon name="receipt" class="tm-icon--inherit" />Mon abonnement</a>
            <a href="{{ base }}#options"><twig:Icon name="layers" class="tm-icon--inherit" />Mes options</a>
            <a href="{{ base }}#factures"><twig:Icon name="file" class="tm-icon--inherit" />Mes factures</a>
            <a href="{{ base }}#paiement"><twig:Icon name="euro" class="tm-icon--inherit" />Mon moyen de paiement</a>
            <a href="{{ path('pro_subscription', {onglet: 'historique'}) }}"{% if tab == 'historique' %} aria-current="page"{% endif %}><twig:Icon name="clock" class="tm-icon--inherit" />Historique</a>
        </nav>

        {% if tab == 'historique' %}
            <section class="tm-pro-card tm-psub__history" aria-labelledby="historique-titre">
                <h2 id="historique-titre" class="tm-pro-card__title"><twig:Icon name="clock" class="tm-icon--inherit" />Historique des crédits</h2>
                <p class="tm-psub__note">Chaque mouvement est conservé tel quel : une correction s’ajoute, rien n’est modifié ni effacé.</p>
                {% if view.history is empty %}
                    <p class="tm-psub__empty">Aucun mouvement pour le moment.</p>
                {% else %}
                    <div class="tm-psub__table-wrap">
                        <table class="tm-psub__table">
                            <thead><tr><th scope="col">Date</th><th scope="col">Mouvement</th><th scope="col" class="is-num">Devis</th><th scope="col" class="is-num">Solde après</th><th scope="col">Référence</th></tr></thead>
                            <tbody>
                                {% for line in view.history %}
                                    <tr>
                                        <td><time datetime="{{ line.at|date('c') }}">{{ line.at|date('d/m/Y H:i', 'Europe/Paris') }}</time></td>
                                        <td>{{ line.label() }}{% if line.reason %}<span class="tm-psub__reason">{{ line.reason }}</span>{% endif %}</td>
                                        <td class="is-num {{ line.amount > 0 ? 'is-plus' : 'is-minus' }}">{{ line.amount > 0 ? '+' }}{{ line.amount }}</td>
                                        <td class="is-num">{{ line.balanceAfter }}</td>
                                        <td>{% if line.referenceType == 'quote' %}Devis {{ line.reference }}{% elseif line.reference %}{{ line.referenceType == 'invoice' ? 'Facture ' }}{{ line.reference }}{% elseif line.type.value == 'manual' %}Équipe TrouveMoi{% else %}—{% endif %}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </section>
        {% else %}
            {% set sub = view.subscription %}
            {% set plan = view.current %}
            {% if sub and sub.status.value in ['past_due', 'suspended'] %}
                <p class="tm-subscribe__notice is-error" role="alert"><twig:Icon name="alert" size="sm" class="tm-icon--inherit" />{{ sub.status.value == 'suspended' ? 'Abonnement suspendu pour impayé : l’envoi de devis est bloqué jusqu’au règlement de votre facture (lien dans l’e-mail reçu).' : 'Le dernier paiement a échoué : réglez votre facture (lien dans l’e-mail reçu) pour continuer à envoyer des devis après la période de grâce.' }}</p>
            {% endif %}
            <div class="tm-psub__top">
                <section class="tm-pro-card tm-psub__current" aria-labelledby="actuel-titre">
                    <span class="tm-psub__tag"><twig:Icon name="euro" size="xs" class="tm-icon--inherit" />Mon abonnement actuel</span>
                    <div class="tm-psub__plan">
                        <twig:Icon name="crown" class="tm-icon--inherit" />
                        <div>
                            <h2 id="actuel-titre">{{ sub ? sub.planName : 'Offre de lancement' }}</h2>
                            <p>{{ sub ? (plan.terms.description ?? 'Prestataire & Artisan') : view.balance.free ~ ' devis gratuit' ~ (view.balance.free > 1 ? 's') ~ ' restant' ~ (view.balance.free > 1 ? 's') }}</p>
                        </div>
                        {% if sub %}
                            <span class="tm-pro-state {{ status_class[sub.status.value] }}">{% if sub.status.value == 'active' %}<twig:Icon name="check" size="xs" class="tm-icon--inherit" />{% endif %}{{ sub.cancelAtPeriodEnd ? 'Résiliation programmée' : sub.status.label() }}</span>
                        {% else %}
                            <span class="tm-pro-state is-ok"><twig:Icon name="check" size="xs" class="tm-icon--inherit" />Actif</span>
                        {% endif %}
                    </div>
                    {% if sub %}
                        <p class="tm-psub__price"><strong>{{ sub.priceCents|tm_money }}</strong> HT / {{ intervals[sub.interval.value] }} <span>(sans engagement)</span></p>
                        <ul class="tm-pro-figures">
                            {% if sub.periodEnd %}
                                {% if sub.cancelAtPeriodEnd %}
                                    <li><twig:Icon name="calendar" class="tm-icon--inherit" />Fin de l’abonnement : {{ sub.periodEnd|date('d/m/Y', 'Europe/Paris') }}</li>
                                {% else %}
                                    <li><twig:Icon name="calendar" class="tm-icon--inherit" />Prochain prélèvement : {{ sub.periodEnd|date('d/m/Y', 'Europe/Paris') }}</li>
                                    <li><twig:Icon name="hourglass" class="tm-icon--inherit" />Fin de période : {{ sub.periodEnd|date('d/m/Y', 'Europe/Paris') }}</li>
                                {% endif %}
                            {% endif %}
                            <li><twig:Icon name="fileEuro" class="tm-icon--inherit" />{% if plan and plan.terms.unlimited %}Devis illimités{% else %}{{ view.balance.plan }} devis restants{% if plan and plan.terms.quotesPerPeriod %} sur {{ plan.terms.quotesPerPeriod }}{% endif %} cette période{% endif %}</li>
                        </ul>
                        {% if sub.totalDays() > 0 %}
                            {% set elapsed = sub.elapsedDays(view.now) %}
                            <div class="tm-psub__period">
                                <p><twig:Icon name="calCheck" class="tm-icon--inherit" /><strong>Période en cours</strong><span>{{ elapsed }} / {{ sub.totalDays() }} jours</span></p>
                                <progress max="{{ sub.totalDays() }}" value="{{ elapsed }}">{{ elapsed }} jours sur {{ sub.totalDays() }}</progress>
                            </div>
                        {% endif %}
                        {% if sub.scheduledOn %}
                            <p class="tm-psub__note tm-psub__scheduled"><twig:Icon name="calendar" size="xs" class="tm-icon--inherit" />Changement programmé le {{ sub.scheduledOn|date('d/m/Y', 'Europe/Paris') }} : {{ sub.scheduledPlanName }}.</p>
                        {% endif %}
                        {% if sub.status.value == 'active' %}
                            <div class="tm-psub__manage">
                                {% if sub.cancelAtPeriodEnd %}
                                    <form method="post" action="{{ path('pro_subscription_resume') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('pro_subscription_action') }}">
                                        <twig:Button type="submit" variant="secondary" icon="refresh" iconPosition="start">Annuler la résiliation</twig:Button>
                                    </form>
                                {% else %}
                                    {% if sub.interval.value == 'month' and plan and plan.yearlyCents is not null %}
                                        <a href="{{ path('pro_subscription_change', {forfait: plan.id, periode: 'an'}) }}">Passer en annuel ({{ plan.yearlyCents|tm_money }} HT / an)</a>
                                    {% endif %}
                                    <a href="{{ path('pro_subscription_cancel') }}" class="tm-psub__leave">Résilier</a>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% else %}
                        <p class="tm-psub__price"><strong>Gratuit</strong> <span>(sans engagement, sans carte bancaire)</span></p>
                        <div class="tm-psub__period">
                            <p><twig:Icon name="fileEuro" class="tm-icon--inherit" /><strong>Devis gratuits utilisés</strong><span>{{ view.balance.freeGranted - view.balance.free }} / {{ view.balance.freeGranted }}</span></p>
                            <progress max="{{ max(1, view.balance.freeGranted) }}" value="{{ view.balance.freeGranted - view.balance.free }}">{{ view.balance.free }} devis restants</progress>
                        </div>
                    {% endif %}
                </section>

                <section class="tm-pro-card tm-psub__included" aria-labelledby="inclus-titre">
                    <h2 id="inclus-titre" class="tm-psub__subtitle">Inclus dans {{ plan ? 'ma formule ' ~ plan.terms.name : 'l’offre de lancement' }}</h2>
                    <ul class="tm-psub__checks">
                        {% if plan %}
                            <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />{{ plan.terms.unlimited ? 'Devis illimités (usage raisonnable)' : plan.terms.quotesPerPeriod ~ ' devis par période' }}</li>
                            {% for feature in plan.terms.features %}<li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />{{ feature }}</li>{% endfor %}
                        {% else %}
                            <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />{{ view.balance.freeGranted }} devis gratuits</li>
                            <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />Profil professionnel vérifié</li>
                            <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />Demandes des clients de votre zone</li>
                        {% endif %}
                    </ul>
                </section>

                <section id="options" class="tm-pro-card tm-psub__options" aria-labelledby="options-titre">
                    <h2 id="options-titre" class="tm-pro-card__title"><twig:Icon name="layers" class="tm-icon--inherit" />Mes options activées</h2>
                    {% set options = [
                        {icon: 'star', label: 'Mise en avant locale', on: plan and plan.terms.featured},
                        {icon: 'chart', label: 'Statistiques avancées', on: plan and plan.terms.advancedStats},
                        {icon: 'tag', label: plan and plan.terms.maxOffers ? 'Offres et promotions (' ~ plan.terms.maxOffers ~ ')' : 'Offres et promotions', on: plan and (plan.terms.maxOffers ?? 0) > 0},
                    ] %}
                    <ul class="tm-psub__opts">
                        {% for o in options %}
                            <li><twig:Icon name="{{ o.icon }}" class="tm-icon--inherit" /><span>{{ o.label }}</span><span class="tm-psub__toggle{{ o.on ? ' is-on' }}" role="img" aria-label="{{ o.on ? 'Incluse' : 'Non incluse' }}"></span></li>
                        {% endfor %}
                    </ul>
                    <p class="tm-psub__note">Les options dépendent de votre formule.</p>
                </section>
            </div>

            <div class="tm-psub__bottom">
                <section id="formules" class="tm-pro-card tm-psub__plans" aria-labelledby="formules-titre">
                    <h2 id="formules-titre" class="tm-pro-card__title"><twig:Icon name="crown" class="tm-icon--inherit" />Nos formules d’abonnement</h2>
                    {% if view.plans is empty %}
                        <p class="tm-psub__empty">Les formules seront bientôt disponibles. En attendant, vos devis gratuits restent utilisables.</p>
                    {% else %}
                        <ul class="tm-psub__grid">
                            {% for p in view.plans %}
                                {% set current = view.isCurrent(p) %}
                                <li class="tm-psub__offer{{ current ? ' is-current' }}">
                                    <p class="tm-psub__offer-name"><twig:Icon name="{{ p.terms.featured ? 'star' : (p.terms.unlimited ? 'rocket' : 'crown') }}" class="tm-icon--inherit" />{{ p.terms.name }}</p>
                                    {% if current %}<span class="tm-psub__mine">Mon abonnement</span>{% elseif p.terms.badge %}<span class="tm-psub__mine">{{ p.terms.badge }}</span>{% endif %}
                                    <p class="tm-psub__offer-price">{{ p.monthlyCents is not null ? p.monthlyCents|tm_money ~ ' HT / mois' : 'Prix à venir' }}</p>
                                    <ul class="tm-psub__checks">
                                        <li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />{{ p.terms.unlimited ? 'Devis illimités' : p.terms.quotesPerPeriod ~ ' devis par mois' }}</li>
                                        {% for feature in p.terms.features %}<li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />{{ feature }}</li>{% endfor %}
                                    </ul>
                                    {% if current %}
                                        <span class="tm-psub__chosen">Formule actuelle</span>
                                    {% elseif p.monthlyCents is not null %}
                                        {% set target = view.subscription ? path('pro_subscription_change', {forfait: p.id, periode: 'mois'}) : path('pro_subscribe', {forfait: p.id, periode: 'mois'}) %}
                                        <twig:Button href="{{ target }}" variant="secondary">Choisir<span class="tm-visually-hidden"> la formule {{ p.terms.name }}</span></twig:Button>
                                    {% else %}
                                        <span class="tm-psub__chosen">Souscription bientôt disponible</span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </section>

                <div class="tm-psub__aside">
                    <section id="factures" class="tm-pro-card" aria-labelledby="factures-titre">
                        <h2 id="factures-titre" class="tm-pro-card__title"><twig:Icon name="file" class="tm-icon--inherit" />Mes factures récentes</h2>
                        <p class="tm-psub__empty">Aucune facture pour le moment. Vos factures d’abonnement apparaîtront ici après votre premier paiement.</p>
                    </section>
                    <section id="paiement" class="tm-pro-card" aria-labelledby="paiement-titre">
                        <h2 id="paiement-titre" class="tm-pro-card__title"><twig:Icon name="receipt" class="tm-icon--inherit" />Mon moyen de paiement</h2>
                        <p class="tm-psub__empty">Aucun moyen de paiement enregistré : il sera ajouté de façon sécurisée lors de votre souscription.</p>
                    </section>
                </div>
            </div>
        {% endif %}
    {% endif %}
</div>
{% endblock %}
