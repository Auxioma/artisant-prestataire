{#- P01 (Figma 78:3) — page d'accueil : blocs publiés en BO10.1, dans l'ordre choisi ; en-tête et pied de page globaux. -#}
{% extends 'base.html.twig' %}
{% set active_nav = 'home' %}
{% block title %}TrouveMoi.com — Artisans & prestataires vérifiés près de chez vous{% endblock %}
{% block meta %}
    {% if preview %}<meta name="robots" content="noindex, nofollow">{% endif %}
    <meta name="description" content="Trouvez un artisan ou un prestataire vérifié près de chez vous : SIRET, Kbis et assurances contrôlés, devis gratuits et sans engagement.">
    {% if not preview %}<link rel="canonical" href="{{ url('public_home') }}">{% endif %}
    {% set hero = blocks|filter(b => b.type == 'hero')|first %}
    {% if hero %}<link rel="preload" as="image" href="{{ asset('images/auth/a02-banner@1x.webp') }}" fetchpriority="high">{% endif %}
{% endblock %}
{% block body %}
<div class="tm-home" data-controller="analytics">
    {% if preview %}<p class="tm-home__preview" role="status">Aperçu du brouillon — non publié</p>{% endif %}
    {% for block in blocks %}
        {% include 'content/home/_' ~ block.type ~ '.html.twig' with {s: block.settings, d: block.data} %}
    {% endfor %}
</div>
{% set website = {'@context': 'https://schema.org', '@type': 'WebSite', name: 'TrouveMoi.com', url: url('public_home'), potentialAction: {'@type': 'SearchAction', target: url('public_search') ~ '?lieu_libelle={search_term_string}', 'query-input': 'required name=search_term_string'}} %}
{# |raw justifié : json_encode avec JSON_HEX_TAG/JSON_HEX_AMP. #}
<script type="application/ld+json" nonce="{{ csp_nonce('script') }}">{{ website|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
{% endblock %}
