{#- Balisage FAQPage (P14.3) : questions et réponses (texte brut). |raw justifié : json_encode avec JSON_HEX_TAG/JSON_HEX_AMP. -#}
{% set faq_ld = {'@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: questions|map(q => {'@type': 'Question', name: q.question, acceptedAnswer: {'@type': 'Answer', text: q.answerHtml|striptags|trim}})} %}
{% if tm_schema('faq') %}<script type="application/ld+json" nonce="{{ csp_nonce('script') }}">{{ faq_ld|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>{% endif %}
