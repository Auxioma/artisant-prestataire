{#-
    P01.2 — hero (maquette « Accueil — Desktop 1440 · V2 ») : photo seule, sans texte affiché (le H1 reste lu par les
    moteurs et les lecteurs d'écran) ; barre de recherche arrondie, centrée sur le bas de la bannière : service
    (autocomplétion métier), lieu (autocomplétion, géolocalisation, dernier lieu mémorisé), bouton « Rechercher ».
-#}
<header class="tm-home-hero tm-home-hero--veil-{{ ((s.veil ?? 0) / 10)|round * 10 }}">
    {# CDC §8 / P01.2 : photo prioritaire (LCP), AVIF puis WebP avec srcset, préchargée (home.html.twig), sans lazy-load. #}
    <picture>
        <source type="image/avif" srcset="{{ asset('images/auth/a02-banner-960.avif') }} 960w, {{ asset('images/auth/a02-banner@1x.avif') }} 1440w" sizes="100vw">
        <source type="image/webp" srcset="{{ asset('images/auth/a02-banner-960.webp') }} 960w, {{ asset('images/auth/a02-banner@1x.webp') }} 1440w" sizes="100vw">
        <img class="tm-home-hero__image" src="{{ asset('images/auth/a02-banner@1x.webp') }}" alt="{{ s.image_alt ?? '' }}" width="1440" height="430" fetchpriority="high" decoding="async">
    </picture>
    <h1 class="tm-visually-hidden">{{ s.title }}</h1>
    {% if s.subtitle %}<p class="tm-visually-hidden tm-home-hero__subtitle">{{ s.subtitle }}</p>{% endif %}
    <svg class="tm-home-hero__wave" viewBox="0 0 1440 46" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 22C360 52 900 -6 1440 20V46H0V22Z" fill="currentColor"/>
    </svg>
    <div class="tm-container tm-container--wide tm-home-hero__content">
        {% include 'search/_search_pill.html.twig' with {prefix: 'home', job_label: s.job_placeholder, job_example: s.job_example ?? '', place_label: s.place_placeholder, place_example: s.place_example ?? '', button: s.button} only %}
    </div>
</header>
