{#- P01.8 — bannière CTA : {max_devis} lu dans quotes.max_per_request (RG-014) ; vers la demande de devis dès qu'elle existe, sinon la recherche. -#}
<section class="tm-home-cta tm-home-cta--{{ s.background }}" aria-labelledby="home-cta">
    <div class="tm-container tm-catalog-cta__inner">
        <div>
            <h2 class="tm-catalog-cta__title" id="home-cta">{{ s.title }}</h2>
            <p class="tm-catalog-cta__text">{{ s.text }}</p>
        </div>
        {% if d.href %}<twig:Button href="{{ d.href }}" icon="arrowR" data-action="analytics#track" data-analytics-event-param="cta_quote_click" data-analytics-placement-param="home_banner">{{ s.button }}</twig:Button>{% endif %}
    </div>
</section>
