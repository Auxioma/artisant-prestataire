{#- P01.3 — bandeau de réassurance (2 à 6 items, lien facultatif). -#}
<section class="tm-home-reassurance tm-home-reassurance--{{ s.mobile_layout ?? 'carousel' }}" aria-label="Nos engagements">
    <ul class="tm-container">
        {% for item in s.items %}
            <li>
                {% if item.href %}<a href="{{ item.href }}">{% endif %}
                <twig:Icon name="{{ item.icon }}" /><span>{{ item.label }}</span>
                {% if item.href %}</a>{% endif %}
            </li>
        {% endfor %}
    </ul>
</section>
