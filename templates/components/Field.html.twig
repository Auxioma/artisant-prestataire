{#
    TM / Input (Figma 59:219) hors formulaire Symfony (les formulaires utilisent le thème templates/form/theme.html.twig).
    Étiquette toujours visible ; aide et erreur reliées par aria-describedby ; erreur = bordure 2 px + icône + message.
#}
{% props id, name, label, type = 'text', value = null, placeholder = null, help = null, error = null, success = null, required = false, disabled = false, readonly = false, icon = null, autocomplete = null %}
{% set state = error ? 'error' : (success ? 'success' : (disabled ? 'disabled' : (readonly ? 'readonly' : null))) %}
{% set describedby = [help and not error and not success ? id ~ '_help', error ? id ~ '_error', success ? id ~ '_success']|filter(v => v) %}
<div {{ attributes.defaults({class: 'tm-field' ~ (state ? ' tm-field--' ~ state)}) }}>
    <label class="tm-field__label" for="{{ id }}">
        {{ label }}{% if required %}<abbr class="tm-field__required" title="obligatoire">*</abbr>{% endif %}
    </label>
    <div class="tm-field__control">
        {% if icon %}<twig:Icon name="{{ icon }}" size="sm" class="tm-icon--inherit" />{% endif %}
        <input class="tm-field__input" id="{{ id }}" name="{{ name }}" type="{{ type }}"
            {%- if value is not null %} value="{{ value }}"{% endif %}
            {%- if placeholder %} placeholder="{{ placeholder }}"{% endif %}
            {%- if autocomplete %} autocomplete="{{ autocomplete }}"{% endif %}
            {%- if required %} required{% endif %}
            {%- if disabled %} disabled{% endif %}
            {%- if readonly %} readonly{% endif %}
            {%- if error %} aria-invalid="true"{% endif %}
            {%- if describedby is not empty %} aria-describedby="{{ describedby|join(' ') }}"{% endif %}>
        {% if error %}<twig:Icon name="alert" size="sm" class="tm-field__status tm-icon--inherit" />{% endif %}
        {% if success %}<twig:Icon name="check" size="sm" class="tm-field__status tm-icon--inherit" />{% endif %}
    </div>
    {% if error %}<p class="tm-field__error" id="{{ id }}_error">{{ error }}</p>
    {% elseif success %}<p class="tm-field__success" id="{{ id }}_success">{{ success }}</p>
    {% elseif help %}<p class="tm-field__help" id="{{ id }}_help">{{ help }}</p>{% endif %}
</div>
