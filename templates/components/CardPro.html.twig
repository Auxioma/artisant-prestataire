{#
    Carte professionnel des maquettes V2 (accueil « Les mieux notés » et « Des professionnels près de chez vous »,
    annuaire) : photo de réalisation (sinon logo), note et nombre d'avis en pastille, nom, métiers, lieu, puis
    « Professionnel vérifié » (footer = verified) ou pastille « Disponible » (footer = available), cœur « favori ».
    footer = profile (maquette « Nos professionnels » V2) : métiers en étiquettes (tags) et bouton « Voir le profil ».
    Le nom porte le lien ; toute la carte est cliquable (lien étendu), le cœur reste un contrôle distinct.
#}
{% props name, href, trades, location, artisanId, tags = [], photo = null, rating = null, reviewsCount = 0, footer = 'verified', available = false, headingLevel = 3, ratingStyle = 'outline' %}{# outline | filled | accent #}
<article {{ attributes.defaults({class: 'tm-card-pro'}) }}>
    <div class="tm-card-pro__media">
        {% if photo %}
            <img src="{{ photo }}" alt="" loading="lazy" decoding="async" width="441" height="170">
        {% else %}
            <span class="tm-card-pro__placeholder"><twig:Icon name="briefcase" /></span>
        {% endif %}
        {% if rating is not null and reviewsCount > 0 %}
            <p class="tm-card-pro__rating tm-card-pro__rating--{{ ratingStyle }}">
                <twig:Icon name="{{ ratingStyle in ['filled', 'accent'] ? 'starFilled' : 'star' }}" size="xs" />
                {# accent (maquette « Nos professionnels ») : « 4,9 (56) », le mot « avis » réservé aux lecteurs d'écran #}
                <span><span class="tm-visually-hidden">Note : </span>{{ rating|number_format(1, ',', ' ') }}<span class="tm-visually-hidden"> sur 5,</span> ({{ reviewsCount|number_format(0, ',', ' ') }}{{ ratingStyle == 'accent' ? '<span class="tm-visually-hidden"> avis</span>' : ' avis' }})</span>
            </p>
        {% endif %}
    </div>
    <div class="tm-card-pro__body">
        <h{{ headingLevel }} class="tm-card-pro__name"><a class="tm-card-pro__link" href="{{ href }}">{{ name }}</a></h{{ headingLevel }}>
        {% if footer == 'profile' %}
            {% if location %}<p class="tm-card-pro__location"><twig:Icon name="pin" size="xs" />{{ location }}</p>{% endif %}
            {% if tags is not empty %}<ul class="tm-card-pro__tags" aria-label="Métiers">{% for tag in tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
            {# Le lien étendu du nom couvre la carte : le bouton est visuel, sans second lien pour les lecteurs d'écran. #}
            <span class="tm-card-pro__cta" aria-hidden="true">Voir le profil</span>
        {% else %}
        {% if trades %}<p class="tm-card-pro__trades">{{ trades }}</p>{% endif %}
        {% if location %}<p class="tm-card-pro__location"><twig:Icon name="pin" size="xs" />{{ location }}</p>{% endif %}
        <div class="tm-card-pro__foot">
            {% if footer == 'available' %}
                {% if available %}<span class="tm-card-pro__available">Disponible</span>{% endif %}
            {% else %}
                <span class="tm-card-pro__verified"><twig:Icon name="checkC" size="xs" />Professionnel vérifié</span>
            {% endif %}
            {% if is_granted('ROLE_CLIENT') %}
                <form class="tm-card-pro__favorite" method="post" action="{{ path('client_favorite_toggle', {artisan: artisanId}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('favorites') }}">
                    <input type="hidden" name="favori" value="1">
                    <input type="hidden" name="retour" value="{{ app.request.requestUri }}">
                    <button type="submit" class="tm-card-pro__heart"><twig:Icon name="heart" size="sm" class="tm-icon--inherit" /><span class="tm-visually-hidden">Ajouter {{ name }} à mes favoris</span></button>
                </form>
            {% elseif not is_granted('IS_AUTHENTICATED') %}
                <a class="tm-card-pro__heart tm-card-pro__favorite" href="{{ path('identity_login') }}"><twig:Icon name="heart" size="sm" class="tm-icon--inherit" /><span class="tm-visually-hidden">Se connecter pour ajouter {{ name }} à mes favoris</span></a>
            {% endif %}
        </div>
        {% endif %}
    </div>
</article>
