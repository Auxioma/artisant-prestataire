{#
    Logo TrouveMoi.com (fichiers fournis : logos/logo_public_fond_{clair,fonce}.png, déclinés en WebP ×2 / ×3).
    À remplacer par le SVG officiel dès réception (description Figma 64:8).
#}
{% props tone = 'clair', href = null, width = 188 %}
{% set img %}
    <img class="tm-logo__img" src="{{ asset('images/brand/logo-' ~ tone ~ '@2x.webp') }}"
         srcset="{{ asset('images/brand/logo-' ~ tone ~ '@2x.webp') }} 2x, {{ asset('images/brand/logo-' ~ tone ~ '@3x.webp') }} 3x"
         width="{{ width }}" height="{{ (width * 306 / 1027)|round }}" alt="TrouveMoi.com — Prestataires & Artisans" decoding="async">
{% endset %}
{% if href %}
    <a {{ attributes.defaults({class: 'tm-logo', href: href}) }}>{{ img }}<span class="tm-visually-hidden"> — accueil</span></a>
{% else %}
    <span {{ attributes.defaults({class: 'tm-logo'}) }}>{{ img }}</span>
{% endif %}
