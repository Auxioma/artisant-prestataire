{#
    TM / Footer (Figma 65:178, P01.10 — CDC §3), mis à jour d'après la maquette « Accueil — Desktop 1440 · V2 » :
    marque et réseaux sociaux, colonnes « Liens utiles », « Aide & compte », « Informations » (séparateurs verticaux),
    colonne « Restez informé » (newsletter), mention de droits et pays. Fond --background-light, vague décorative (388:17040).
    Mobile : colonnes en accordéon (ouvertes sans JavaScript), newsletter pleine largeur.
#}
{# BO10.5 — colonnes administrables (tm_menu) #}
{% set columns = [
    {title: tm_label('footer.column_useful', 'Liens utiles'), links: tm_menu('footer_useful')},
    {title: tm_label('footer.column_help', 'Aide & compte'), links: tm_menu('footer_help')},
    {title: tm_label('footer.column_info', 'Informations'), links: tm_menu('footer_info')},
] %}
<footer {{ attributes.defaults({class: 'tm-footer'}) }}>
    <svg class="tm-footer__wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="tm-footer__wave-fill" transform="translate(0 10.47)" d="M0 29.5285C300 -10.4715 520 59.5285 860 23.5285C1200 -12.4715 1260 -0.47146 1440 15.5285V59.5285H0V29.5285Z"/>
        <path class="tm-footer__wave-line" transform="translate(0 7.97)" d="M0.330409 32.0285C300.33 -7.97146 520.33 62.0285 860.33 26.0285C1200.33 -9.97146 1260.33 2.02854 1440.33 18.0285" fill="none" stroke-width="5"/>
        <path class="tm-footer__wave-accent" transform="translate(637 8.8)" d="M3.00031 43.2065C263 11.2065 513 -2.79353 803 5.20647" fill="none" stroke-width="6" stroke-linecap="round"/>
    </svg>
    <div class="tm-footer__body">
        <div class="tm-footer__columns">
            <div class="tm-footer__brand">
                <twig:Logo href="{{ tm_path('public_home') }}" />
                <p class="tm-footer__tagline">{{ tm_label('footer.tagline', 'La plateforme qui vous met en relation avec des artisans et prestataires de confiance, partout en France.') }}</p>
                {% set socials = tm_social_links() %}
                {% if socials is not empty %}
                    <ul class="tm-footer__socials">
                        {% for social in socials %}
                            <li><a class="tm-footer__social" href="{{ social.url }}" target="_blank" rel="noopener noreferrer">
                                <twig:Icon name="brand-{{ social.network }}" size="sm" class="tm-icon--inherit" /><span class="tm-visually-hidden">{{ social.label }} (nouvel onglet)</span>
                            </a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {% for column in columns %}
                <details class="tm-footer__column" open data-controller="footer-accordion">
                    <summary class="tm-footer__title">{{ column.title }}<twig:Icon name="chevD" size="sm" class="tm-footer__chevron tm-icon--inherit" /></summary>
                    <ul class="tm-footer__links">
                        {% for link in column.links %}
                            <li>
                                {% if link.special == 'cookies' %}
                                    <button type="button" class="tm-footer__link" data-cookie-consent-open aria-haspopup="dialog">{{ link.label }}</button>
                                {% else %}
                                    <a class="tm-footer__link" href="{{ link.href }}"{% if link.newTab %} target="_blank" rel="noopener"{% endif %}>{{ link.label }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </details>
            {% endfor %}

            {% if tm_route_exists('content_newsletter_subscribe') %}
                <form class="tm-footer__newsletter" id="newsletter" method="post" action="{{ tm_path('content_newsletter_subscribe') }}">
                    <p class="tm-footer__title">{{ tm_label('footer.newsletter_title', 'Restez informé') }}</p>
                    <p class="tm-footer__text">{{ tm_label('footer.newsletter_text', 'Recevez nos actualités, offres et nouveautés.') }}</p>
                    <label class="tm-visually-hidden" for="newsletter_email">Votre adresse e-mail</label>
                    <span class="tm-footer__email">
                        <twig:Icon name="mail" size="sm" class="tm-icon--inherit" />
                        <input id="newsletter_email" name="email" type="email" placeholder="Votre adresse e-mail" autocomplete="email" maxlength="254" required>
                    </span>
                    <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                    <button type="submit" class="tm-footer__subscribe">{{ tm_label('footer.newsletter_submit', 'S’inscrire') }}</button>
                </form>
            {% endif %}
        </div>
        <div class="tm-footer__bottom">
            <p>© {{ 'now'|date('Y') }} {{ tm_label('footer.copyright', 'TrouveMoi.com – Artisans & Prestataires. Tous droits réservés.') }}</p>
            {# Information L111-7 du code de la consommation (critères de classement), accessible depuis toutes les pages. #}
            <p class="tm-footer__legal"><a class="tm-footer__link" href="{{ tm_path('content_how_it_works') }}#classement">{{ tm_label('footer.ranking_link', 'Comment sont classés les professionnels ?') }}</a></p>
            <p class="tm-footer__country">{{ tm_label('footer.country', 'France') }}<twig:Icon name="chevD" size="xs" class="tm-icon--inherit" /></p>
        </div>
    </div>
</footer>
