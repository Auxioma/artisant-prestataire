{#
    TM / Footer (Figma 65:178, P01.10 — CDC §3). Structure de la bibliothèque V2 (65:49) sur fond --background-light
    (CDC §2.1 ; la variante marine #0A1F5C hors palette n'est pas retenue — P-29). Vague décorative de la variante claire (388:17040).
    Mobile : colonnes en accordéon (ouvertes sans JavaScript), newsletter pleine largeur.
#}
{% set columns = [
    {title: 'Liens utiles', links: [
        {label: 'Catégories', href: tm_path('catalog_categories')},
        {label: 'Nos professionnels', href: tm_path('search_directory')},
        {label: 'Les mieux notés', href: tm_path('search_top_rated')},
        {label: 'Disponibilités', href: tm_path('search_availability')},
        {label: 'Offres & promotions', href: tm_path('search_offers')},
        {label: 'Tarifs professionnels', href: tm_path('content_pricing')},
        {label: 'Blog', href: tm_path('content_blog')},
    ]},
    {title: 'Informations', links: [
        {label: 'CGU', href: tm_path('content_page', {slug: 'cgu'})},
        {label: 'CGV', href: tm_path('content_page', {slug: 'cgv'})},
        {label: 'Confidentialité', href: tm_path('content_page', {slug: 'politique-de-confidentialite'})},
        {label: 'Mentions légales', href: tm_path('content_page', {slug: 'mentions-legales'})},
        {label: 'Cookies', href: tm_path('content_page', {slug: 'cookies'})},
        {label: 'Gérer mes cookies', consent: true},
        {label: 'Plan du site', href: tm_path('content_sitemap')},
    ]},
    {title: 'Aide', links: [
        {label: 'Comment ça marche ?', href: tm_path('content_how_it_works')},
        {label: 'Aide / FAQ', href: tm_path('content_faq')},
        {label: 'Contact', href: tm_path('content_contact')},
        {label: 'Créer mon compte pro', href: tm_path('identity_register_pro')},
    ]},
] %}
<footer {{ attributes.defaults({class: 'tm-footer'}) }}>
    <svg class="tm-footer__wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="tm-footer__wave-fill" transform="translate(0 10.47)" d="M0 29.5285C300 -10.4715 520 59.5285 860 23.5285C1200 -12.4715 1260 -0.47146 1440 15.5285V59.5285H0V29.5285Z"/>
        <path class="tm-footer__wave-line" transform="translate(0 7.97)" d="M0.330409 32.0285C300.33 -7.97146 520.33 62.0285 860.33 26.0285C1200.33 -9.97146 1260.33 2.02854 1440.33 18.0285" fill="none" stroke-width="5"/>
        <path class="tm-footer__wave-accent" transform="translate(637 8.8)" d="M3.00031 43.2065C263 11.2065 513 -2.79353 803 5.20647" fill="none" stroke-width="6" stroke-linecap="round"/>
    </svg>
    <div class="tm-footer__body">
        <div class="tm-footer__columns">
            <div class="tm-footer__brand">
                <twig:Logo href="{{ tm_path('public_home') }}" />
                <p class="tm-footer__tagline">La plateforme qui met en relation particuliers, entreprises et artisans vérifiés, partout en France.</p>
                {% set socials = tm_social_links() %}
                {% if socials is not empty %}
                    <ul class="tm-footer__socials">
                        {% for social in socials %}
                            <li><a class="tm-footer__social" href="{{ social.url }}" target="_blank" rel="noopener noreferrer">
                                <twig:Icon name="brand-{{ social.network }}" size="sm" class="tm-icon--inherit" /><span class="tm-visually-hidden">{{ social.label }} (nouvel onglet)</span>
                            </a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            {% for column in columns %}
                <details class="tm-footer__column" open data-controller="footer-accordion">
                    <summary class="tm-footer__title">{{ column.title }}<twig:Icon name="chevD" size="sm" class="tm-footer__chevron tm-icon--inherit" /></summary>
                    <ul class="tm-footer__links">
                        {% for link in column.links %}
                            <li>
                                {% if link.consent is defined %}
                                    <button type="button" class="tm-footer__link" data-cookie-consent-open aria-haspopup="dialog">{{ link.label }}</button>
                                {% else %}
                                    <a class="tm-footer__link" href="{{ link.href }}">{{ link.label }}</a>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </details>
            {% endfor %}

            {% if tm_route_exists('content_newsletter_subscribe') %}
                <form class="tm-footer__newsletter" method="post" action="{{ tm_path('content_newsletter_subscribe') }}">
                    <p class="tm-footer__title">Newsletter</p>
                    <p class="tm-footer__text">Conseils travaux et nouveautés, une fois par mois.</p>
                    <twig:Field id="newsletter_email" name="email" type="email" label="Votre adresse email" icon="mail" autocomplete="email" required class="tm-footer__field" />
                    <twig:Checkbox id="newsletter_consent" name="consent" label="J’accepte de recevoir la newsletter TrouveMoi. Désinscription en un clic." required />
                    <input type="hidden" name="_token" value="{{ csrf_token('newsletter') }}">
                    <twig:Button type="submit">S’inscrire</twig:Button>
                </form>
            {% endif %}
        </div>
        <div class="tm-footer__bottom">
            <p>© {{ 'now'|date('Y') }} TrouveMoi.com — Auxioma</p>
            <p>Opérateur de plateforme en ligne · <a class="tm-footer__link" href="{{ tm_path('content_page', {slug: 'classement-des-professionnels'}) }}">Comment sont classés les professionnels ?</a></p>
        </div>
    </div>
</footer>
