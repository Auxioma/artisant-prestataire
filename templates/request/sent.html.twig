{#- P11.7 — confirmation d'envoi (Figma 25:3) : demande et zone, référence, prochaine étape, actions, prochaines étapes détaillées. Le délai moyen de première réponse n'est affiché qu'une fois mesuré (P-64). -#}
{% extends 'base.html.twig' %}
{% set noindex = true %}
{% set header_variant = 'tunnel' %}

{% block title %}Demande envoyée — TrouveMoi{% endblock %}

{% block body %}
{% set zone = (city ?? request.postalCode) ~ ' (' ~ request.postalCode ~ ')' %}
{% set subject = request.details.title ?? (job.name ?? 'votre projet') %}
<div class="tm-request">
    <div class="tm-container tm-request__sent">
        <section class="tm-card-panel tm-request__main" aria-labelledby="sent-title">
            <span class="tm-request__sent-icon" aria-hidden="true"><twig:Icon name="check" class="tm-icon--inherit" /></span>
            {% if request.status.value == 'pending_moderation' %}
                <h1 id="sent-title">Votre demande est en cours de vérification.</h1>
                <p class="tm-body">Notre équipe la relit avant de la transmettre aux professionnels ; vous serez prévenu par e-mail.</p>
            {% else %}
                <h1 id="sent-title">Votre demande a bien été envoyée.</h1>
                <p class="tm-body">Vous pouvez suivre les réponses des artisans depuis votre espace client.</p>
            {% endif %}
            <div class="tm-request__sent-card">
                <p class="tm-card-title">Demande : {{ subject|lower }}</p>
                <p class="tm-caption">Zone : {{ zone }} · Jusqu’à {{ request.maxQuotes }} devis possibles · Référence : {{ request.number }}{{ target ? ' · Demande directe à ' ~ target.name }}</p>
            </div>
            <p class="tm-caption">Prochaine étape : les artisans correspondant à votre métier et à votre zone pourront examiner votre demande.</p>
            <div class="tm-request__actions">
                {% if tm_route_exists('client_requests') %}<twig:Button href="{{ path('client_requests') }}">Consulter mes demandes</twig:Button>{% endif %}
                <twig:Button variant="soft" href="{{ path('public_home') }}">Retour à l’accueil</twig:Button>
            </div>
            <div class="tm-request__next">
                <h2 class="tm-card-title">Demande n° {{ request.number }} · prochaines étapes</h2>
                <ul>
                    <li><twig:Icon name="check" size="xs" />Votre demande est diffusée aux artisans vérifiés de votre zone.</li>
                    {% if average_response %}<li><twig:Icon name="clock" size="xs" />Délai moyen de première réponse : {{ average_response }}.</li>{% endif %}
                    <li><twig:Icon name="file" size="xs" />Vous recevez jusqu’à {{ request.maxQuotes }} devis : comparez-les dans votre espace.</li>
                    <li><twig:Icon name="upload" size="xs" />Ajoutez des photos manquantes pour des devis plus précis.</li>
                </ul>
            </div>
        </section>
    </div>
</div>
{% endblock %}
