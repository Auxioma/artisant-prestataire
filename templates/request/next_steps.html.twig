{#- Étapes 4 à 6 (lieu et délai, coordonnées, récapitulatif) : livrées avec T-402b. Page provisoire : le brouillon est conservé. -#}
{% extends 'request/_layout.html.twig' %}

{% block title %}{{ steps[step - 1] }} — Demande de devis — TrouveMoi{% endblock %}
{% block step_title %}{{ steps[step - 1] }}{% endblock %}
{% block step_subtitle %}Votre brouillon est enregistré.{% endblock %}

{% block step_content %}
    <twig:EmptyState title="Étape bientôt disponible" text="[PROVISOIRE — T-402b] Les étapes « Lieu & délai », « Coordonnées » et « Récapitulatif » arrivent avec le prochain lot. Votre brouillon est conservé." />
    <div class="tm-request__actions"><twig:Button variant="secondary" href="{{ path('request_step', {step: 3}) }}">← Étape précédente</twig:Button></div>
{% endblock %}

{% block step_why %}
    <li><twig:Icon name="check" size="xs" />Votre brouillon est conservé 30 jours.</li>
{% endblock %}
