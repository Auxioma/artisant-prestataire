{#- P06 — annuaire « Nos professionnels » (maquette Koubourath V2) : bannière et recherche superposée ; page d'entrée (sans filtre ni pagination) : engagements, catégories, professionnels à la une et encart pro ; puis annuaire (filtres métier, département, initiale, grille 3/2/1, pagination numérotée). -#}
{% extends 'base.html.twig' %}
{% set active_nav = 'pros' %}
{% set page = result.page %}
{% macro page_url(n, filters) %}{{ filters is empty ? (n == 1 ? path('search_directory') : path('search_directory_page', {page: n})) : path('search_directory', filters|merge(n > 1 ? {page: n} : {})) }}{% endmacro %}
{% import _self as m %}
{% block title %}Nos professionnels vérifiés{{ page > 1 ? ' — page ' ~ page }} — TrouveMoi{% endblock %}
{% set canonical_url = app.request.schemeAndHttpHost ~ m.page_url(filters is empty ? page : 1, {})|trim %}
{% set meta_description %}Annuaire des artisans et prestataires vérifiés par TrouveMoi : SIRET, Kbis et assurances contrôlés. Parcourez-les par métier, département ou ordre alphabétique.{% endset %}
{% block meta %}
    {% if filters is not empty %}<meta name="robots" content="noindex, follow">{% endif %}
{% endblock %}
{% block body %}
<div class="tm-catalog tm-directory" data-controller="analytics" data-analytics-auto-event-value="directory_view" data-analytics-auto-type-value="{{ page }}">
    <div class="tm-directory__hero">
        <twig:PageBanner title="Nos professionnels" subtitle="Découvrez des artisans et prestataires de confiance près de chez vous !" image="images/auth/a02-banner" />
        <div class="tm-container tm-directory__search">
            {% include 'search/_search_pill.html.twig' with {prefix: 'directory', compact: true, place_first: true, job_icon: 'bars',
                place_label: 'Où recherchez-vous ?', place_example: 'Où recherchez-vous ? (ville, code postal, département…)',
                job_label: 'Quel service ?', job_example: 'Quel service ? (ex. plomberie, électricité…)', button: 'Rechercher'} only %}
        </div>
    </div>
    {% if landing %}
        <section class="tm-home-reassurance tm-home-reassurance--grid tm-directory__reassurance" aria-label="Nos engagements">
            <ul class="tm-container tm-container--wide">
                {% for item in [
                    {icon: 'shield', lines: ['Professionnels', 'vérifiés']},
                    {icon: 'star', lines: ['Avis clients', 'et notations']},
                    {icon: 'zap', lines: ['Devis rapides', 'et gratuits']},
                    {icon: 'pin', lines: ['Proches de', 'chez vous']},
                    {icon: 'checkC', lines: ['Qualité &', 'fiabilité']},
                ] %}
                    <li><twig:Icon name="{{ item.icon }}" /><span>{{ item.lines|first }}<br>{{ item.lines|last }}</span></li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
    <div class="tm-container tm-container--wide tm-catalog__body">
        {% if not landing %}<twig:Breadcrumb :items="[{label: 'Accueil', href: tm_path('public_home')}, {label: 'Nos professionnels'}]" />{% endif %}

        {% if landing %}
            <section aria-labelledby="directory-categories">
                <h2 class="tm-section-title" id="directory-categories">Trouvez le professionnel qu’il vous faut</h2>
                <ul class="tm-directory__categories">
                    {% for c in categories %}
                        {% set image = tm_category_image(c.slug) %}
                        <li>
                            <a class="tm-directory__category" href="{{ path('catalog_category', {slug: c.slug}) }}" data-action="analytics#track" data-analytics-event-param="category_card_click" data-analytics-type-param="{{ c.slug }}">
                                <twig:Icon name="{{ c.icon }}" class="tm-directory__category-icon" />
                                <span class="tm-directory__category-name">{{ c.name|e|replace({' &amp; ': '<br>&amp; '})|raw }}</span>
                                {% if image %}<img src="{{ image }}" alt="" loading="lazy" decoding="async" width="136" height="68">{% endif %}
                            </a>
                        </li>
                    {% endfor %}
                    <li>
                        <a class="tm-directory__category tm-directory__category--more" href="{{ path('catalog_categories') }}">
                            <twig:Icon name="more" class="tm-directory__category-icon" />
                            <span class="tm-directory__category-name">Autres<br>services</span>
                        </a>
                    </li>
                </ul>
            </section>
        {% endif %}

        <div class="tm-directory__featured-row">
            {% if landing and featured is not empty %}
                <section aria-labelledby="directory-featured">
                    <h2 class="tm-section-title" id="directory-featured">Nos professionnels à la une</h2>
                    <ul class="tm-directory__featured">
                        {% for hit in featured %}<li data-action="click->analytics#track" data-analytics-event-param="pro_card_click">{% include 'catalog/_pro_card.html.twig' with {hit: hit, job_names: job_names, footer: 'profile', rating_style: 'accent'} only %}</li>{% endfor %}
                    </ul>
                </section>
            {% endif %}
            <aside class="tm-directory__pro" aria-labelledby="pro-title">
                <twig:Icon name="crown" class="tm-directory__pro-icon" />
                <div>
                    <h2 id="pro-title">Vous êtes un professionnel ?</h2>
                    <ul>
                        <li><twig:Icon name="checkC" size="sm" />Gagnez en visibilité locale et nationale</li>
                        <li><twig:Icon name="checkC" size="sm" />Recevez des demandes qualifiées</li>
                        <li><twig:Icon name="checkC" size="sm" />Gérez vos devis, votre agenda et vos clients</li>
                        <li><twig:Icon name="checkC" size="sm" />Valorisez vos avis et votre expertise</li>
                        {% if free_credits > 0 %}<li><twig:Icon name="checkC" size="sm" /><span><strong>{{ free_credits }} devis offerts</strong> à la validation de votre dossier</span></li>{% endif %}
                    </ul>
                </div>
                <twig:Button href="{{ tm_path('identity_register_pro') }}" icon="userPlus" iconPosition="start" data-action="analytics#track" data-analytics-event-param="pro_signup_cta_click" data-analytics-type-param="directory">Créer mon compte professionnel</twig:Button>
            </aside>
        </div>

        <section aria-labelledby="directory-title">
            <div class="tm-catalog__head">
                <h2 class="tm-section-title" id="directory-title">Tous les professionnels vérifiés</h2>
                <p class="tm-search__count" role="status">{{ result.total|number_format(0, ',', ' ') }} professionnel{{ result.total > 1 ? 's' }}{% if result.pages > 1 %} · page {{ page }} sur {{ result.pages }}{% endif %}</p>
            </div>

            <form method="get" action="{{ path('search_directory') }}" class="tm-directory__filters" data-controller="autosubmit" data-turbo="false">
                <twig:Select id="metier" name="metier" label="Métier" :options="{'': 'Tous les métiers'}|merge(jobs|reduce((carry, j) => carry|merge({(j.slug): j.name}), {}))" value="{{ job ? job.slug : '' }}" data-action="change->autosubmit#submit" />
                <twig:Select id="departement" name="departement" label="Département" :options="department_options" value="{{ department ?? '' }}" data-action="change->autosubmit#submit" />
                {% if letter %}<input type="hidden" name="lettre" value="{{ letter }}">{% endif %}
                <noscript><twig:Button type="submit" variant="secondary">Filtrer</twig:Button></noscript>
                {% if filters is not empty %}<a class="tm-directory__reset" href="{{ path('search_directory') }}">Effacer les filtres</a>{% endif %}
            </form>

            <nav class="tm-directory__letters" aria-label="Filtre alphabétique">
                <ul>
                    <li><a href="{{ path('search_directory', filters|filter((v, k) => k != 'lettre')) }}"{% if not letter %} aria-current="true"{% endif %}>Tous</a></li>
                    {% for l in letters %}
                        <li>
                            {% if l in result.letters %}
                                <a href="{{ path('search_directory', filters|merge({lettre: l})) }}"{% if l == letter %} aria-current="true"{% endif %}>{{ l == '#' ? '0–9' : l }}</a>
                            {% else %}
                                <span aria-disabled="true">{{ l == '#' ? '0–9' : l }}</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            {% if result.artisans is empty %}
                <twig:EmptyState icon="users" title="Aucun professionnel ne correspond à ces filtres" text="Élargissez votre sélection ou recherchez près de chez vous.">
                    <twig:Button href="{{ path('search_directory') }}" variant="secondary">Voir tous les professionnels</twig:Button>
                </twig:EmptyState>
            {% else %}
                <ul class="tm-directory__grid">
                    {% for a in result.artisans %}
                        <li>{% include 'catalog/_pro_card.html.twig' with {hit: {artisan: a}, job_names: job_names, footer: 'profile', rating_style: 'accent'} only %}</li>
                    {% endfor %}
                </ul>
            {% endif %}

            {% if result.pages > 1 %}
                <nav class="tm-directory__pagination" aria-label="Pagination">
                    <ul>
                        {% if page > 1 %}<li><a href="{{ m.page_url(page - 1, filters)|trim }}"><twig:Icon name="chevL" size="sm" /><span class="tm-visually-hidden">Page précédente</span></a></li>{% endif %}
                        {% for n in 1..result.pages %}
                            {% if n == 1 or n == result.pages or (n >= page - 2 and n <= page + 2) %}
                                <li>{% if n == page %}<span aria-current="page">{{ n }}</span>{% else %}<a href="{{ m.page_url(n, filters)|trim }}">{{ n }}</a>{% endif %}</li>
                            {% elseif n == page - 3 or n == page + 3 %}
                                <li><span aria-hidden="true">…</span></li>
                            {% endif %}
                        {% endfor %}
                        {% if page < result.pages %}<li><a href="{{ m.page_url(page + 1, filters)|trim }}"><span class="tm-visually-hidden">Page suivante</span><twig:Icon name="chevR" size="sm" /></a></li>{% endif %}
                    </ul>
                </nav>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
