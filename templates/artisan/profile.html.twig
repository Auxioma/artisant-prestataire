{#-
    P10 — fiche artisan publique, maquette V2 (Koubourath « Fiche artisan publique ») : photo de couverture (1re réalisation),
    logo rond, identité, bandeau des contrôles, actions (devis, message, favori, partage), onglets d'ancres soulignés ;
    colonne principale (présentation, prestations, réalisations, zone et horaires, avis, informations légales) et colonne
    latérale collante (disponibilités sur 14 jours → demande de devis pré-remplie, certifications & assurances, contact).
-#}
{% extends 'base.html.twig' %}
{% set p = profile %}
{% set pres = p.presentation %}
{% set canonical = tm_artisan_url(p.profileId, p.name, p.communeName, true) %}
{% set place = p.communeName ? p.communeName ~ (p.departmentCode ? ' (' ~ p.departmentCode ~ ')') : null %}
{% set job_names = [] %}{% for j in jobs %}{% set job_names = job_names|merge([j.name]) %}{% endfor %}
{% set department_areas = [] %}{% for name in departments %}{% set department_areas = department_areas|merge([{'@type': 'AdministrativeArea', name: name}]) %}{% endfor %}
{% set logo = p.hasLogo ? path('public_artisan_logo', {id: p.profileId}) : null %}
{% set revealed = app.flashes('artisan_phone')|first %}
{% set cover = null %}{% for project in p.portfolio %}{% if not cover and project.photos is not empty %}{% set cover = path('public_portfolio_photo', {id: p.profileId, photo: (project.photos|first).id}) %}{% endif %}{% endfor %}
{% set short_checks = {'SIRET actif au répertoire Sirene': 'SIRET', 'Pièce d’identité du dirigeant': 'identité du dirigeant', 'Extrait Kbis ou avis de situation INSEE': 'Kbis', 'Attestation d’assurance décennale': 'assurance décennale', 'Attestation d’assurance RC Professionnelle': 'assurance RC Pro'} %}
{% set checks = p.verifiedChecks|map(c => short_checks[c] ?? c|lower) %}
{% set day_short = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'] %}
{% set day_long = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'] %}
{% set months = ['', 'janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
{% macro hour(d) %}{{ d|date('G', 'Europe/Paris') }} h{{ d|date('i', 'Europe/Paris') != '00' ? d|date('i', 'Europe/Paris') }}{% endmacro %}
{% macro range(r) %}{% set parts = r|split('-') %}{% for t in parts %}{% set hm = t|split(':') %}{{ hm[0]|number_format }} h{{ hm[1] != '00' ? hm[1] }}{{ not loop.last ? ' – ' }}{% endfor %}{% endmacro %}
{% import _self as m %}
{% set summary = p.description ?? (p.name ~ ', professionnel vérifié' ~ (main_job ? ' — ' ~ main_job.name) ~ (place ? ' ' ~ place|a_lieu) ~ '.') %}
{% set seo = tm_seo_meta('artisan', {nom: p.name, metier: main_job ? main_job.name : null, ville: p.communeName, a_ville: p.communeName ? p.communeName|a_lieu : null}) %}
{% block title %}{{ seo.title ?? (p.name ~ (main_job ? ' — ' ~ main_job.name) ~ (p.communeName ? ' ' ~ p.communeName|a_lieu) ~ ' | TrouveMoi') }}{% endblock %}
{% set meta_description = seo.description ?? (summary|length > 155 ? summary|slice(0, 154) ~ '…' : summary) %}
{% set canonical_url = canonical %}
{% set og_type = 'profile' %}
{% set og_image = logo ? app.request.schemeAndHttpHost ~ logo : null %}
{% block body %}
<div class="tm-profile" data-controller="analytics" data-analytics-auto-event-value="pro_profile_view" data-analytics-auto-type-value="{{ main_job ? main_job.slug }}">
    <div class="tm-profile__top">
        <div class="tm-container">
            <twig:Breadcrumb :items="[{label: 'Accueil', href: tm_path('public_home')}]
                |merge(main_job ? [{label: main_job.categoryName, href: tm_path('catalog_category', {slug: main_job.categorySlug})}] : [])
                |merge(main_job and p.communeInsee ? [{label: main_job.name ~ (p.communeName ? ' ' ~ p.communeName|a_lieu), href: path('public_search', {metier: main_job.slug, lieu: p.communeInsee})}] : [])
                |merge([{label: p.name}])" />

            <div class="tm-profile__cover{{ cover ? '' : ' tm-profile__cover--plain' }}">
                {% if cover %}<img src="{{ cover }}" alt="" width="1200" height="375" decoding="async" fetchpriority="high">{% endif %}
            </div>

            <header class="tm-profile__header">
                <div class="tm-profile__logo">
                    {% if logo %}<img src="{{ logo }}" alt="Logo de {{ p.name }}" width="124" height="124" decoding="async">
                    {% else %}<span class="tm-profile__initials" aria-hidden="true">{{ p.name|slice(0, 1)|upper }}</span>{% endif %}
                </div>
                <div class="tm-profile__identity">
                    <div class="tm-profile__title-row">
                        <h1 class="tm-profile__name">{{ p.name }}</h1>
                        <div class="tm-profile__badges">
                            <details class="tm-profile__verified">
                                <summary><twig:Badge variant="verified">Vérifié</twig:Badge><span class="tm-visually-hidden"> — voir ce qui a été contrôlé</span></summary>
                                <div class="tm-profile__verified-panel">
                                    <p>Dossier contrôlé par l’équipe TrouveMoi le {{ p.verifiedAt|date('d/m/Y', 'Europe/Paris') }} :</p>
                                    <ul>{% for check in p.verifiedChecks %}<li><twig:Icon name="check" size="xs" />{{ check }}</li>{% endfor %}</ul>
                                    <p class="tm-profile__fine">Le badge ne garantit pas la qualité des travaux ; il atteste de l’existence de l’entreprise et de ses justificatifs à la date du contrôle.</p>
                                </div>
                            </details>
                            {% if p.availableSoon %}<twig:Badge variant="available" />{% endif %}
                            {% if reviews.count == 0 %}<twig:Badge variant="new">Nouveau</twig:Badge>{% endif %}
                        </div>
                    </div>
                    {% if pres and pres.slogan %}<p class="tm-profile__slogan">{{ pres.slogan }}</p>{% endif %}
                    {% if checks is not empty %}
                        <p class="tm-profile__checks"><twig:Icon name="shield" size="xs" class="tm-icon--inherit" />
                            {%- set text = checks|length > 1 ? checks|slice(0, -1)|join(', ') ~ ' et ' ~ checks|last : checks|first -%}
                            {{ text|slice(0, 1)|upper ~ text|slice(1) }} vérifié{{ checks|length > 1 ? 's' }} le {{ p.verifiedAt|date('d/m/Y', 'Europe/Paris') }}</p>
                    {% endif %}
                    {% if reviews.count > 0 %}
                        <a class="tm-profile__rating" href="#avis"><span class="tm-pr-stars" aria-hidden="true">{% for i in 1..5 %}<twig:Icon name="{{ i <= reviews.average|round ? 'starFilled' : 'star' }}" size="xs" class="tm-icon--inherit{{ i <= reviews.average|round ? ' is-on' }}" />{% endfor %}</span><strong>{{ reviews.average|number_format(1, ',', ' ') }}</strong><span class="tm-profile__rating-count">{{ reviews.count }} avis certifié{{ reviews.count > 1 ? 's' }}</span><span class="tm-visually-hidden"> — note moyenne sur 5</span></a>
                    {% else %}
                        <p class="tm-profile__no-review">Aucun avis pour le moment</p>
                    {% endif %}
                    <ul class="tm-profile__facts">
                        {% if job_names is not empty %}<li><twig:Icon name="wrench" size="xs" />{{ job_names|join(' · ') }}</li>{% endif %}
                        {% if place %}<li><twig:Icon name="pin" size="xs" />{{ place }}
                            {%- if p.areaMode == 'radius' and p.areaRadiusKm %} · intervient dans un rayon de {{ p.areaRadiusKm }} km
                            {%- elseif p.areaMode == 'list' %} · intervient sur {{ (departments|length + p.areaCommunesCount) }} zone{{ (departments|length + p.areaCommunesCount) > 1 ? 's' }}{% endif %}</li>{% endif %}
                        {% if response_minutes ?? null %}<li><twig:Icon name="clock" size="xs" />Répond en {{ response_minutes < 60 ? response_minutes ~ ' min' : (response_minutes < 1440 ? (response_minutes / 60)|round ~ ' h' : (response_minutes / 1440)|round ~ ' j') }} en moyenne</li>{% endif %}
                        {% if p.companyCreatedOn %}<li><twig:Icon name="building" size="xs" />Entreprise créée en {{ p.companyCreatedOn|date('Y') }}</li>{% endif %}
                        <li><twig:Icon name="calendar" size="xs" />Sur TrouveMoi depuis {{ months[p.memberSince|date('n', 'Europe/Paris')] }} {{ p.memberSince|date('Y', 'Europe/Paris') }}</li>
                    </ul>
                </div>
                <div class="tm-profile__actions">
                    {% if not p.acceptsDirectRequests %}
                        <p class="tm-profile__paused"><twig:Icon name="clock" size="xs" />Ne prend pas de nouvelles demandes pour le moment.</p>
                    {% elseif tm_route_exists('request_new') %}<twig:Button href="{{ path('request_new', {pro: p.profileId}) }}" rel="nofollow">Demander un devis</twig:Button>{% endif %}
                    {% if tm_route_exists('client_message_new') and not is_granted('ROLE_ARTISAN') %}<twig:Button href="{{ path('client_message_new', {artisan: p.profileId}) }}" variant="secondary" rel="nofollow">Envoyer un message</twig:Button>{% endif %}
                    {% if tm_route_exists('client_favorite_toggle') and is_granted('ROLE_CLIENT') %}
                        <form method="post" action="{{ path('client_favorite_toggle', {artisan: p.profileId}) }}" class="tm-profile__favorite">
                            <input type="hidden" name="_token" value="{{ csrf_token('favorites') }}">
                            <input type="hidden" name="favori" value="{{ is_favorite ? '0' : '1' }}">
                            <input type="hidden" name="retour" value="{{ app.request.requestUri }}">
                            <button type="submit" class="tm-profile__round" aria-pressed="{{ is_favorite ? 'true' : 'false' }}"><twig:Icon name="{{ is_favorite ? 'heartFilled' : 'heart' }}" size="sm" class="tm-icon--inherit" /><span class="tm-visually-hidden">{{ is_favorite ? 'Retirer de mes favoris' : 'Ajouter à mes favoris' }}</span></button>
                        </form>
                    {% elseif tm_route_exists('client_favorites') and not is_granted('ROLE_ARTISAN') %}
                        <a class="tm-profile__round" href="{{ path('client_favorites') }}" rel="nofollow"><twig:Icon name="heart" size="sm" class="tm-icon--inherit" /><span class="tm-visually-hidden">Ajouter à mes favoris (connexion requise)</span></a>
                    {% endif %}
                    <span class="tm-profile__share" data-controller="share" data-share-url-value="{{ canonical }}" data-share-title-value="{{ p.name }}">
                        <button type="button" class="tm-profile__round" data-action="share#share"><twig:Icon name="share" size="sm" class="tm-icon--inherit" /><span class="tm-visually-hidden">Partager la fiche</span></button>
                        <span class="tm-profile__share-status" data-share-target="status" role="status"></span>
                    </span>
                </div>
            </header>
        </div>
        <nav class="tm-profile__nav" aria-label="Sections de la fiche">
            <ul class="tm-container">
                <li><a href="#presentation">Présentation</a></li>
                {% if p.services is not empty %}<li><a href="#prestations">Prestations</a></li>{% endif %}
                {% if p.portfolio is not empty %}<li><a href="#realisations">Réalisations</a></li>{% endif %}
                <li><a href="#disponibilites">Disponibilités</a></li>
                <li><a href="#avis">Avis{{ reviews.count > 0 ? ' (' ~ reviews.count ~ ')' }}</a></li>
                <li><a href="#informations">Infos légales</a></li>
            </ul>
        </nav>
    </div>

    <div class="tm-container tm-profile__layout">
        <div class="tm-profile__main">
            <section class="tm-profile__section" id="presentation" aria-labelledby="presentation-title">
                <h2 id="presentation-title">Présentation</h2>
                {% if pres and pres.description %}<div class="tm-profile__description tm-profile__rich">{{ pres.description|tm_rich_text }}</div>
                {% elseif p.description %}<p class="tm-profile__description">{{ p.description }}</p>
                {% else %}<p class="tm-profile__muted">Ce professionnel n’a pas encore rédigé sa présentation.</p>{% endif %}
                {% if pres and pres.strengths is not empty %}
                    <h3 class="tm-visually-hidden">Points forts</h3>
                    <ul class="tm-profile__strengths">{% for s in pres.strengths %}<li><twig:Icon name="check" size="xs" class="tm-icon--inherit" />{{ s }}</li>{% endfor %}</ul>
                {% endif %}
                <dl class="tm-profile__rows">
                    {% if jobs is not empty %}<div><dt>Métiers</dt><dd>{% for j in jobs %}{{ j.name }}{% if main_job and j.id == main_job.id %} <span class="tm-profile__muted">(principal)</span>{% endif %}{{ not loop.last ? ', ' }}{% endfor %}</dd></div>{% endif %}
                    {% if pres and pres.yearsExperience is not null %}<div><dt>Expérience</dt><dd>{{ pres.yearsExperience }} an{{ pres.yearsExperience > 1 ? 's' }}</dd></div>{% endif %}
                    {% if pres and pres.languages is not empty %}<div><dt>Langues parlées</dt><dd>{{ pres.languages|map(l => (languages[l] ?? l))|join(', ') }}</dd></div>{% endif %}
                    {% if pres and pres.clients is not empty %}<div><dt>Clients acceptés</dt><dd>{{ pres.clients|map(c => (clients[c] ?? c))|join(', ') }}</dd></div>{% endif %}
                </dl>
            </section>

            {% if p.services is not empty %}
                <section class="tm-profile__section" id="prestations" aria-labelledby="prestations-title">
                    <h2 id="prestations-title">Prestations et tarifs indicatifs</h2>
                    <ul class="tm-profile__services">{% for s in p.services %}<li><span>{{ s.title }}</span><strong>{{ s.price ?: 'sur devis' }}</strong></li>{% endfor %}</ul>
                    <p class="tm-profile__fine">Prix indicatifs communiqués par le professionnel ; le devis fait foi.</p>
                </section>
            {% endif %}

            {% if p.portfolio is not empty %}
                <section class="tm-profile__section" id="realisations" aria-labelledby="realisations-title">
                    <h2 id="realisations-title">Réalisations</h2>
                    <ul class="tm-profile__projects">
                        {% for project in p.portfolio %}
                            {% set first = project.photos|first %}
                            <li class="tm-profile__project">
                                {% if first %}
                                    <a class="tm-profile__project-photo" href="{{ path('public_portfolio_photo', {id: p.profileId, photo: first.id}) }}" target="_blank" rel="noopener"><img src="{{ path('public_portfolio_photo', {id: p.profileId, photo: first.id}) }}" alt="{{ project.title }}" width="320" height="245" loading="lazy" decoding="async">{% if project.photos|length > 1 %}<span class="tm-profile__project-count">{{ project.photos|length }} photos</span>{% endif %}</a>
                                {% endif %}
                                <h3>{{ project.title }}</h3>
                                {% set meta = [project.city, project.doneOn ? months[project.doneOn|date('n')]|slice(0, 4) ~ (months[project.doneOn|date('n')]|length > 4 ? '.') ~ ' ' ~ project.doneOn|date('Y') : null]|filter(v => v) %}
                                {% if meta is not empty %}<p class="tm-profile__muted">{{ meta|join(' · ') }}</p>{% endif %}
                                {% if project.description %}<p class="tm-profile__project-text">{{ project.description }}</p>{% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            <section class="tm-profile__section" id="zone" aria-labelledby="zone-title">
                <h2 id="zone-title">Zone d’intervention et horaires</h2>
                <div class="tm-profile__zone">
                    <div class="tm-profile__map" aria-hidden="true">
                        <span class="tm-profile__map-circle"><twig:Icon name="pin" size="sm" class="tm-icon--inherit" /></span>
                        <span class="tm-profile__map-label">{% if p.areaMode == 'radius' and area_center %}Rayon {{ p.areaRadiusKm }} km autour de {{ area_center.name }}{% elseif p.areaMode == 'list' %}{{ departments|length + p.areaCommunesCount }} zone{{ (departments|length + p.areaCommunesCount) > 1 ? 's' }} d’intervention{% else %}Zone non renseignée{% endif %}</span>
                    </div>
                    <dl class="tm-profile__rows">
                        {% if p.hours and p.hours.isSet %}
                            {# Jours consécutifs aux mêmes horaires regroupés (« Lundi – vendredi »). #}
                            {% set groups = [] %}
                            {% for day in hours_days %}
                                {% set value = (p.hours.days[day] ?? [])|map(r => m.range(r))|join(', ') %}
                                {% if groups is not empty and (groups|last).value == value %}
                                    {% set groups = groups|slice(0, -1)|merge([(groups|last)|merge({last: day})]) %}
                                {% else %}
                                    {% set groups = groups|merge([{first: day, last: day, value: value}]) %}
                                {% endif %}
                            {% endfor %}
                            {% for g in groups %}<div><dt>{{ g.first|capitalize }}{{ g.last != g.first ? ' – ' ~ g.last }}</dt><dd>{{ g.value ?: 'Fermé' }}</dd></div>{% endfor %}
                        {% endif %}
                        {% if p.hours %}<div><dt>Interventions d’urgence</dt><dd>{{ p.hours.emergencies ? 'Oui' ~ (p.hours.emergencyNote ? ', ' ~ p.hours.emergencyNote) : 'Non' }}</dd></div>{% endif %}
                        {% if p.areaMode == 'radius' and area_center %}<div><dt>Rayon d’intervention</dt><dd>{{ p.areaRadiusKm }} km autour de {{ area_center.name }} ({{ area_center.departmentCode }})</dd></div>
                        {% elseif p.areaMode == 'list' %}
                            {% if departments is not empty %}<div><dt>Départements</dt><dd>{{ departments|map((name, code) => name ~ ' (' ~ code ~ ')')|join(', ') }}</dd></div>{% endif %}
                            {% if p.areaCommunesCount > 0 %}<div><dt>Communes</dt><dd>{{ p.areaCommunesCount }} commune{{ p.areaCommunesCount > 1 ? 's' }} choisie{{ p.areaCommunesCount > 1 ? 's' }}</dd></div>{% endif %}
                        {% endif %}
                    </dl>
                </div>
                {% if main_job and p.communeInsee %}<p class="tm-profile__zone-link"><a href="{{ path('public_search', {metier: main_job.slug, lieu: p.communeInsee}) }}">Voir d’autres {{ main_job.name|lower }}s autour de {{ p.communeName }}</a></p>{% endif %}
            </section>
            <section class="tm-profile__section" id="avis" aria-labelledby="avis-title">
                <h2 id="avis-title">Avis clients certifiés</h2>
                {% if reviews.count == 0 %}
                    <twig:EmptyState icon="star" title="Ce professionnel n’a pas encore reçu d’avis">
                        Les avis apparaîtront ici après les premières prestations réalisées via TrouveMoi.
                    </twig:EmptyState>
                {% else %}
                    <div class="tm-profile__reviews-summary">
                        <div class="tm-profile__reviews-score"><strong>{{ reviews.average|number_format(1, ',', ' ') }}</strong><span class="tm-pr-stars" aria-hidden="true">{% for i in 1..5 %}<twig:Icon name="{{ i <= reviews.average|round ? 'starFilled' : 'star' }}" size="xs" class="tm-icon--inherit{{ i <= reviews.average|round ? ' is-on' }}" />{% endfor %}</span><span>{{ reviews.count }} avis</span></div>
                        <ul class="tm-pr__bars" aria-label="Répartition des notes">
                            {% for n in 5..1 %}<li><span>{{ n }} ét.</span><span class="tm-pr__bar"><span class="tm-pr__fill is-{{ (reviews.share(n) / 5)|round * 5 }}"></span></span><span>{{ reviews.distribution[n] ?? 0 }}</span></li>{% endfor %}
                        </ul>
                        {% if reviews.criteria is not empty %}
                            <dl class="tm-pr__criteria">
                                {% for key, label in {quality: 'Qualité', punctuality: 'Ponctualité', cleanliness: 'Propreté', value: 'Rapport qualité/prix', communication: 'Communication'} %}{% if reviews.criteria[key] is defined %}<div><dt>{{ label }}</dt><dd>{{ reviews.criteria[key]|number_format(1, ',', ' ') }}</dd></div>{% endif %}{% endfor %}
                            </dl>
                        {% endif %}
                    </div>
                    {% set tri = app.request.query.get('tri', 'recents') %}
                    {% set note = app.request.query.get('note', 'toutes') %}
                    <form method="get" action="{{ app.request.pathInfo }}#avis" class="tm-profile__reviews-tools" data-controller="autosubmit">
                        <label class="tm-visually-hidden" for="tri-avis">Trier les avis</label>
                        <div class="tm-field__control tm-profile__sort"><span>Trier :</span><select class="tm-field__input" id="tri-avis" name="tri" data-action="autosubmit#submit">{% for k, l in review_sorts %}<option value="{{ k }}"{% if tri == k %} selected{% endif %}>{{ l }}</option>{% endfor %}</select></div>
                        {% if note != 'toutes' %}<input type="hidden" name="note" value="{{ note }}">{% endif %}
                        <noscript><button type="submit" class="tm-button tm-button--secondary">Trier</button></noscript>
                    </form>
                    <nav class="tm-profile__reviews-filters" aria-label="Filtrer par note">
                        {% for k, l in review_filters %}<a href="{{ path('public_artisan_profile', {slug: app.request.attributes.get('slug'), id: p.profileId, tri: tri != 'recents' ? tri : null, note: k != 'toutes' ? k : null}|filter(v => v is not null)) }}#avis"{% if note == k %} aria-current="page"{% endif %}>{{ l }}</a>{% endfor %}
                    </nav>
                    <ol class="tm-profile__reviews">
                        {% for r in reviews.items %}
                            <li>
                                <p class="tm-profile__review-head"><span class="tm-pr-stars" aria-hidden="true">{% for i in 1..5 %}<twig:Icon name="{{ i <= r.rating ? 'starFilled' : 'star' }}" size="xs" class="tm-icon--inherit{{ i <= r.rating ? ' is-on' }}" />{% endfor %}</span><strong>{{ r.rating }}/5</strong><strong>{{ r.author }}{% if r.city %} · {{ r.city }}{% endif %}</strong><span class="tm-profile__certified"><twig:Icon name="check" size="xs" class="tm-icon--inherit" />Avis certifié — prestation du {{ r.serviceDate|date('d/m/Y') }}</span></p>
                                {% if r.title %}<p class="tm-profile__review-title">{{ r.title }}</p>{% endif %}
                                <p class="tm-profile__review-text">{{ r.text }}</p>
                                {% if r.photos is not empty %}<p class="tm-pr__photos">{% for f in r.photos %}<a href="{{ path('review_photo', {review: r.id, file: f}) }}" target="_blank" rel="noopener"><img src="{{ path('review_photo', {review: r.id, file: f}) }}" alt="Photo {{ loop.index }} de l’avis de {{ r.author }}" width="72" height="72" loading="lazy"></a>{% endfor %}</p>{% endif %}
                                {% if r.reply %}<div class="tm-profile__reply"><p><strong>Réponse de {{ p.name }}</strong></p><p>{{ r.reply }}</p></div>{% endif %}
                                <a class="tm-profile__report" href="{{ path('moderation_report', {type: 'avis', id: r.id, retour: app.request.requestUri}) }}" rel="nofollow">Signaler cet avis</a>
                            </li>
                        {% else %}
                            <li class="tm-profile__muted">Aucun avis avec cette note.</li>
                        {% endfor %}
                    </ol>
                {% endif %}
                <p class="tm-profile__fine" id="avis-controle">
                    <twig:Icon name="info" size="xs" /> Avis contrôlés (art. L111-7-2 du Code de la consommation) : seul un client dont la demande a abouti
                    à une prestation via TrouveMoi peut déposer un avis. Les avis sont modérés avant publication, sans contrepartie, et affichés
                    du plus récent au plus ancien ; la note n’est affichée qu’à partir du premier avis publié.
                    {% if tm_route_exists('identity_legal_document') %}<a href="{{ path('identity_legal_document', {slug: 'cgu'}) }}">Fonctionnement des avis (CGU)</a>{% endif %}
                </p>
                {% if reviews.matching > reviews.items|length %}<twig:Button href="{{ path('public_artisan_profile', {slug: app.request.attributes.get('slug'), id: p.profileId, tri: app.request.query.get('tri'), note: app.request.query.get('note'), avis: reviews.items|length + 10}|filter(v => v is not null)) }}#avis" variant="secondary">Afficher 10 avis de plus</twig:Button>{% endif %}
            </section>

            <section class="tm-profile__section" id="informations" aria-labelledby="informations-title">
                <h2 id="informations-title">Informations légales</h2>
                <dl class="tm-profile__rows">
                    <div><dt>Raison sociale</dt><dd>{{ p.companyName }}</dd></div>
                    {% if p.tradeName and p.tradeName != p.companyName %}<div><dt>Nom commercial</dt><dd>{{ p.tradeName }}</dd></div>{% endif %}
                    <div><dt>SIRET</dt><dd>{{ p.siret|slice(0, 3) }} {{ p.siret|slice(3, 3) }} {{ p.siret|slice(6, 3) }} {{ p.siret|slice(9) }}</dd></div>
                    {% if p.legalForm %}<div><dt>Forme juridique (code INSEE)</dt><dd>{{ p.legalForm }}</dd></div>{% endif %}
                    {% if p.ape %}<div><dt>Code APE</dt><dd>{{ p.ape }}</dd></div>{% endif %}
                    {% if p.vatNumber %}<div><dt>N° de TVA intracommunautaire</dt><dd>{{ p.vatNumber }}</dd></div>{% endif %}
                    {% if p.postalCode %}<div><dt>Siège</dt><dd>{{ p.postalCode ? p.postalCode ~ ' ' }}{{ p.communeName }}</dd></div>{% endif %}
                </dl>
                <p class="tm-profile__fine">Données issues du répertoire Sirene (INSEE) et déclarées par le professionnel.</p>
            </section>
        </div>

        <aside class="tm-profile__aside" id="contact" aria-label="Disponibilités et garanties">
            <section class="tm-profile__card tm-profile__avail" id="disponibilites" aria-labelledby="dispo-title">
                <h2 id="dispo-title">Disponibilités</h2>
                {% if slot_days is empty or not p.acceptsDirectRequests %}
                    <p class="tm-profile__muted">Aucun créneau ouvert sur les 14 prochains jours.</p>
                    {% if p.acceptsDirectRequests and tm_route_exists('request_new') %}<twig:Button href="{{ path('request_new', {pro: p.profileId}) }}" rel="nofollow" block>Demander un devis</twig:Button>{% endif %}
                {% else %}
                    <p class="tm-profile__fine">Créneaux ouverts sur les 14 prochains jours</p>
                    <form method="get" action="{{ path('request_new') }}" data-turbo="false" rel="nofollow">
                        <input type="hidden" name="pro" value="{{ p.profileId }}">
                        {% set first_open = slot_days|keys|first %}
                        <fieldset class="tm-profile__days">
                            <legend class="tm-visually-hidden">Choisissez un jour</legend>
                            {% for i in 0..13 %}
                                {% set d = today|date_modify('+' ~ i ~ ' days') %}
                                {% set key = d|date('Y-m-d', 'Europe/Paris') %}
                                <label class="tm-profile__day{{ slot_days[key] is defined ? ' is-open' }}">
                                    <input type="radio" name="date" value="{{ key }}"{% if slot_days[key] is not defined %} disabled{% endif %}{% if key == first_open %} checked{% endif %}>
                                    <span>{{ day_short[d|date('w', 'Europe/Paris')] }}</span><strong>{{ d|date('j', 'Europe/Paris') }}</strong>
                                    <span class="tm-visually-hidden"> {{ months[d|date('n', 'Europe/Paris')] }}{{ slot_days[key] is defined ? '' : ' (aucun créneau)' }}</span>
                                </label>
                            {% endfor %}
                        </fieldset>
                        {% for i in 0..13 %}
                            {% set d = today|date_modify('+' ~ i ~ ' days') %}
                            {% set key = d|date('Y-m-d', 'Europe/Paris') %}
                            <fieldset class="tm-profile__slots">
                                {% if slot_days[key] is defined %}
                                    <legend>{{ day_long[d|date('w', 'Europe/Paris')] }} {{ d|date('j', 'Europe/Paris') }} {{ months[d|date('n', 'Europe/Paris')] }}</legend>
                                    {% set parts = [] %}
                                    {% for s in slot_days[key] %}
                                        {% set part = s.starts_at|date('G', 'Europe/Paris') < 12 ? 'morning' : 'afternoon' %}
                                        <label class="tm-profile__slot"><input type="radio" name="creneau" value="{{ part }}"{% if key == first_open and loop.first %} checked{% endif %}><span>{{ m.hour(s.starts_at) }} – {{ m.hour(s.ends_at) }}</span></label>
                                    {% endfor %}
                                {% endif %}
                            </fieldset>
                        {% endfor %}
                        <twig:Button type="submit" block data-action="analytics#track" data-analytics-event-param="slot_click">Demander un devis pour ce créneau</twig:Button>
                    </form>
                    <p class="tm-profile__fine">Le créneau n’est réservé qu’après confirmation de l’artisan.</p>
                {% endif %}
                {% if p.phoneAvailable %}
                    <div class="tm-profile__phone" data-controller="phone-reveal">
                        {% if revealed %}
                            <twig:Button variant="secondary" href="tel:{{ revealed|replace({' ': ''}) }}" icon="phone" iconPosition="start" block>{{ revealed }}</twig:Button>
                        {% else %}
                            <form method="post" action="{{ path('public_artisan_phone', {id: p.profileId}) }}" data-phone-reveal-target="form" data-action="phone-reveal#reveal" data-turbo="false">
                                <input type="hidden" name="_token" value="{{ csrf_token('phone_reveal') }}">
                                <twig:Button type="submit" variant="secondary" icon="phone" iconPosition="start" block>Afficher le téléphone</twig:Button>
                            </form>
                            <p class="tm-profile__phone-number" data-phone-reveal-target="output" role="status" hidden></p>
                        {% endif %}
                    </div>
                {% endif %}
            </section>

            <section class="tm-profile__card" id="garanties" aria-labelledby="garanties-title">
                <h2 id="garanties-title">Certifications & assurances</h2>
                {% set credentials = p.insurances|merge(p.qualifications) %}
                {% if credentials is empty %}
                    <p class="tm-profile__muted">Aucune assurance ni certification déclarée.</p>
                {% else %}
                    <ul class="tm-profile__credentials">
                        {% for c in credentials %}
                            <li class="tm-profile__credential{{ c.verified ? ' is-verified' }}">
                                <span class="tm-profile__credential-icon"><twig:Icon name="{{ c.verified ? 'shield' : 'file' }}" size="xs" class="tm-icon--inherit" /></span>
                                <div>
                                    <p class="tm-profile__credential-name">{{ c.label }} {% if c.verified %}<twig:Badge variant="verified">Vérifié</twig:Badge>{% else %}<twig:Badge variant="neutral">Déclaré</twig:Badge>{% endif %}</p>
                                    <p class="tm-profile__muted">{{ c.issuer ? c.issuer ~ ' · ' }}{{ c.validUntil ? 'valide jusqu’au ' ~ c.validUntil|date('d/m/Y') : 'sans date d’échéance' }}</p>
                                </div>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="tm-profile__fine">« Vérifié » : attestation contrôlée par l’équipe TrouveMoi et en cours de validité ; « Déclaré » : information fournie par le professionnel. Les documents eux-mêmes ne sont pas publics.</p>
                {% endif %}
            </section>
            {% if not is_owner|default(false) %}<a class="tm-profile__report tm-profile__report--profile" href="{{ path('moderation_report', {type: 'profil', id: p.profileId, retour: app.request.requestUri}) }}" rel="nofollow"><twig:Icon name="alert" size="xs" class="tm-icon--inherit" />Signaler ce profil</a>{% endif %}
        </aside>
    </div>

    {% if similar is not empty %}
        <section class="tm-profile__similar" aria-labelledby="similar-title">
            <div class="tm-container">
                <h2 id="similar-title" class="tm-section-title">Professionnels similaires</h2>
                <ul class="tm-profile__similar-list">
                    {% for hit in similar %}<li>{% include 'catalog/_pro_card.html.twig' with {hit: hit, job_names: similar_jobs|map(j => j.name), footer: 'available', rating_style: 'accent'} only %}</li>{% endfor %}
                </ul>
            </div>
        </section>
    {% endif %}
</div>
{% set business = {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': canonical ~ '#entreprise',
    name: p.name,
    legalName: p.companyName,
    url: canonical,
    identifier: {'@type': 'PropertyValue', propertyID: 'SIRET', value: p.siret},
    address: {'@type': 'PostalAddress', addressLocality: p.communeName, addressCountry: 'FR'}|merge(p.postalCode ? {postalCode: p.postalCode} : {}),
    knowsAbout: job_names,
}|merge(p.description ? {description: p.description} : {})
 |merge(logo ? {logo: app.request.schemeAndHttpHost ~ logo, image: app.request.schemeAndHttpHost ~ logo} : {})
 |merge(p.vatNumber ? {vatID: p.vatNumber} : {})
 |merge(area_center and p.areaRadiusKm ? {areaServed: {'@type': 'GeoCircle', geoMidpoint: {'@type': 'Place', name: area_center.name}, geoRadius: p.areaRadiusKm * 1000}} : (departments is not empty ? {areaServed: department_areas} : {})) %}
{% if reviews.count > 0 %}{% set business = business|merge({aggregateRating: {'@type': 'AggregateRating', ratingValue: reviews.average, reviewCount: reviews.count, bestRating: 5, worstRating: 1}}) %}{% endif %}
{# AggregateRating seulement à partir du premier avis publié. |raw justifié : json_encode avec JSON_HEX_TAG/JSON_HEX_AMP. #}
{% if tm_schema('local_business') %}<script type="application/ld+json" nonce="{{ csp_nonce('script') }}">{{ business|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>{% endif %}
{% endblock %}
