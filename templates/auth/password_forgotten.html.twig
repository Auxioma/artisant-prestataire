{#- A05.1 — Mot de passe oublié (Figma 230:12452). Réponse identique que le compte existe ou non. -#}
{% extends 'base.html.twig' %}
{% set header_variant = 'tunnel' %}

{% block title %}Mot de passe oublié — TrouveMoi{% endblock %}

{% block body %}
<div class="tm-auth-page">
    <section class="tm-container tm-auth-message">
        <div class="tm-state-card tm-card-panel">
            <span class="tm-state-card__icon tm-state-card__icon--info"><twig:Icon name="info" class="tm-icon--inherit" /></span>
            <h1 class="tm-state-card__title">Mot de passe oublié ?</h1>
            <p class="tm-body-sm">Saisissez votre adresse email : nous vous envoyons un lien de réinitialisation valable {{ tm_setting_int('auth.password_reset_ttl_min') >= 60 ? '1 heure' : tm_setting_int('auth.password_reset_ttl_min') ~ ' minutes' }}.</p>
            <form method="post" action="{{ path('identity_password_forgotten') }}" class="tm-state-card__form tm-signup__fields" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_id) }}">
                <twig:Field id="forgotten_email" name="email" type="email" label="Adresse email" value="{{ email }}" required autocomplete="email" placeholder="votre@email.com" error="{{ error }}" />
                <twig:Button type="submit" block>Recevoir le lien</twig:Button>
            </form>
            {% if sent %}
                <div class="tm-form-success" role="status"><twig:Icon name="check" size="sm" class="tm-icon--inherit" /><p>Si un compte existe pour cette adresse, vous allez recevoir un email avec un lien de réinitialisation.</p></div>
            {% endif %}
            <a href="{{ path('identity_login') }}" class="tm-body-sm"><strong>← Retour à la connexion</strong></a>
            <p class="tm-caption">3 demandes par heure maximum.</p>
        </div>
    </section>
</div>
{% endblock %}
