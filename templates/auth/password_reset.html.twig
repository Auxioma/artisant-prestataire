{#- A05.2 — Nouveau mot de passe / lien expiré (Figma 230:12498). -#}
{% extends 'base.html.twig' %}
{% set header_variant = 'tunnel' %}

{% block title %}{{ form ? 'Nouveau mot de passe' : 'Lien expiré' }} — TrouveMoi{% endblock %}
{# Le jeton est dans l'URL : jamais transmis dans l'en-tête Referer #}
{% block meta %}<meta name="referrer" content="no-referrer">{% endblock %}

{% block body %}
<div class="tm-auth-page">
    <section class="tm-container tm-auth-message">
        {% if form %}
            <div class="tm-state-card tm-state-card--wide tm-card-panel">
                <span class="tm-state-card__icon tm-state-card__icon--info"><twig:Icon name="lock" class="tm-icon--inherit" /></span>
                <h1 class="tm-state-card__title">Choisissez un nouveau mot de passe</h1>
                {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-turbo': 'false', class: 'tm-signup__fields'}}) }}
                    {{ form_errors(form) }}
                    {{ include('auth/_password_row.html.twig', {field: form.password.first, gauge: true}) }}
                    {{ include('auth/_password_row.html.twig', {field: form.password.second}) }}
                    <twig:Button type="submit" block>Enregistrer et me connecter</twig:Button>
                {{ form_end(form) }}
                <p class="tm-caption">Toutes vos sessions actives seront déconnectées et un email de confirmation vous sera envoyé.</p>
            </div>
        {% else %}
            <div class="tm-state-card tm-card-panel">
                <span class="tm-state-card__icon tm-state-card__icon--danger"><twig:Icon name="alert" class="tm-icon--inherit" /></span>
                <h1 class="tm-state-card__title">Ce lien a expiré</h1>
                <p class="tm-body-sm">Pour votre sécurité, les liens de réinitialisation sont valables {{ tm_setting_int('auth.password_reset_ttl_min') >= 60 ? '1 heure' : tm_setting_int('auth.password_reset_ttl_min') ~ ' minutes' }} et utilisables une seule fois.</p>
                <twig:Button variant="secondary" href="{{ path('identity_password_forgotten') }}" block>Renvoyer un lien</twig:Button>
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
