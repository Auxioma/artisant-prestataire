{#- Champ mot de passe (thème TM / Input) + bouton afficher / masquer (CDC A02). Paramètres : field, gauge (bool). -#}
{% set has_errors = field.vars.errors|length > 0 %}
<div class="tm-field{{ has_errors ? ' tm-field--error' }}" data-controller="password">
    {{ form_label(field) }}
    <div class="tm-field__control">
        <twig:Icon name="lock" size="sm" class="tm-icon--inherit" />
        {{ form_widget(field, {attr: field.vars.attr|merge({'data-password-target': 'input'})}) }}
        <button type="button" class="tm-field__toggle" data-action="password#toggle" data-password-target="toggle"
                aria-controls="{{ field.vars.id }}" aria-pressed="false" aria-label="Afficher le mot de passe">
            <twig:Icon name="eye" size="sm" class="tm-icon--inherit" data-password-target="showIcon" />
            <twig:Icon name="eyeOff" size="sm" class="tm-icon--inherit" data-password-target="hideIcon" hidden />
        </button>
    </div>
    {% if gauge|default(false) %}
        <div class="tm-strength" data-password-target="gauge" hidden>
            <div class="tm-strength__bar"><span class="tm-strength__fill" data-password-target="fill"></span></div>
            <p class="tm-strength__label tm-caption" data-password-target="label" aria-live="polite"></p>
        </div>
    {% endif %}
    {{ form_errors(field) }}
    {% if not has_errors %}{{ form_help(field) }}{% endif %}
</div>
