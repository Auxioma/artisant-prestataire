{#-
    BO01 « Tableau de bord » (Figma 186:75) : choix du mois et export (en-tête), dix indicateurs clés comparés à N-1
    (BO01.1) puis les autres indicateurs du CDC, files d'attente (BO01.2). Écarts : P-139.
-#}
{% extends 'admin/base.html.twig' %}
{% set active_module = 'dashboard' %}
{% set month_names = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}
{% macro month_label(ym, names) %}{{ names[ym|split('-')[1] - 1]|capitalize }} {{ ym|split('-')[0] }}{% endmacro %}
{% macro value(card) %}
    {%- set v = card.value -%}
    {%- if v is null -%}—
    {%- elseif card.unit == 'rate' -%}{% set p = (v * 100)|round(1) %}{{ p == p|round ? p|number_format(0, ',', ' ') : p|number_format(1, ',', ' ') }} %
    {%- elseif card.unit == 'minutes' -%}{% set m = v|round %}{{ m >= 60 ? (m // 60) ~ ' h ' ~ '%02d'|format(m % 60) : m ~ ' min' }}
    {%- elseif card.unit == 'cents' -%}{{ (v / 100)|number_format(0, ',', ' ') }} €
    {%- elseif card.unit == 'rating' -%}{{ v|number_format(1, ',', ' ') }} / 5
    {%- else -%}{{ v|number_format(0, ',', ' ') }}
    {%- endif -%}
{% endmacro %}
{% macro delta(card) %}
    {%- set d = card.delta -%}
    {%- if card.deltaUnit == 'pts' or card.deltaUnit == '' -%}{% set shown = d|round(1) %}{% set text = shown == shown|round ? shown|abs|number_format(0, ',', ' ') : shown|abs|number_format(1, ',', ' ') %}
    {%- else -%}{% set shown = d|round %}{% set text = shown|abs|number_format(0, ',', ' ') %}
    {%- endif -%}
    {{ shown > 0 ? '+' : (shown < 0 ? '−' : '') }}{{ text }}{{ card.deltaUnit ? ' ' ~ card.deltaUnit }}
{% endmacro %}
{% macro card(card) %}
    {% import _self as m %}
    <li class="tm-bo01-kpi">
        <span class="tm-bo01-kpi__label">{{ card.label }}</span>
        <strong class="tm-bo01-kpi__value">{{ m.value(card) }}</strong>
        {% if card.metric.snapshotOnly() %}
            <span class="tm-bo01-kpi__delta is-warn">À relancer</span>
        {% elseif card.value is null and card.key == 'visitors' %}
            <span class="tm-bo01-kpi__delta">Non mesuré (aucun outil d’audience)</span>
        {% elseif card.delta is null %}
            <span class="tm-bo01-kpi__delta">{{ card.previous is null ? 'Pas de référence N-1' : 'N-1 : ' ~ m.value({value: card.previous, unit: card.unit}) }}</span>
        {% else %}
            <span class="tm-bo01-kpi__delta"><span class="is-{{ card.tone }}">{{ m.delta(card) }}</span> vs N-1</span>
        {% endif %}
    </li>
{% endmacro %}
{% import _self as m %}
{% block title %}Tableau de bord{% endblock %}
{% block body %}
    <nav class="tm-admin-crumbs" aria-label="Fil d’Ariane"><ol><li><a href="{{ path('admin_dashboard') }}">Back-office</a></li><li aria-current="page">Tableau de bord</li></ol></nav>
    <div class="tm-admin-head">
        <div>
            <h1>Tableau de bord</h1>
            <p class="tm-admin-head__sub">Activité du 1er au {{ kpis.lastDay|date('j', 'Europe/Paris') }} {{ month_names[kpis.from|date('n', 'Europe/Paris') - 1] }} {{ kpis.from|date('Y', 'Europe/Paris') }} · comparaison avec {{ month_names[kpis.previousFrom|date('n', 'Europe/Paris') - 1] }} {{ kpis.previousFrom|date('Y', 'Europe/Paris') }}</p>
        </div>
        <div class="tm-bo01-actions">
            <form method="get" action="{{ path('admin_dashboard') }}" data-controller="autosubmit" class="tm-bo01-month">
                <label class="tm-visually-hidden" for="bo01_mois">Mois affiché</label>
                <div class="tm-field__control"><select class="tm-field__input" id="bo01_mois" name="mois" data-action="change->autosubmit#submit">
                    {% for ym in months %}<option value="{{ ym }}"{{ ym == kpis.month ? ' selected' }}>{{ m.month_label(ym, month_names) }}</option>{% endfor %}
                </select></div>
                <noscript><twig:Button type="submit" variant="secondary">Afficher</twig:Button></noscript>
            </form>
            {% if is_granted('admin.dashboard.export') %}<twig:Button href="{{ path('admin_dashboard_export', {mois: kpis.month}) }}" variant="secondary">Exporter</twig:Button>{% endif %}
        </div>
    </div>

    <ul class="tm-bo01-kpis" aria-label="Indicateurs clés">
        {% for card in kpis.featured %}{{ m.card(card) }}{% endfor %}
    </ul>
    <details class="tm-bo01-more">
        <summary>Tous les indicateurs ({{ kpis.others|length }} de plus)</summary>
        <ul class="tm-bo01-kpis tm-bo01-kpis--more" aria-label="Autres indicateurs">
            {% for card in kpis.others %}{{ m.card(card) }}{% endfor %}
        </ul>
    </details>

    <div class="tm-bo01-grid">
        <section class="tm-admin-panel" aria-labelledby="files-titre">
            <h2 id="files-titre" class="tm-card-title">Files d’attente</h2>
            <ul class="tm-admin-queues">
                {% for queue in queues|filter(q => is_granted(q.permission)) %}
                    <li><twig:Icon name="{{ queue.icon }}" size="sm" class="tm-icon--inherit" />{% if queue.route is defined %}<a href="{{ path(queue.route, queue.params ?? {}) }}">{{ queue.label }}</a>{% else %}<span>{{ queue.label }}</span>{% endif %}<span class="tm-admin-count{{ queue.count > 0 ? ' tm-admin-count--todo' }}">{{ queue.count }}</span></li>
                {% else %}
                    <li>Aucune file d’attente pour votre rôle.</li>
                {% endfor %}
            </ul>
        </section>
    </div>
{% endblock %}
