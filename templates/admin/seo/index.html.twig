{#- BO12 — SEO : gabarits et surcharges (BO12.1), redirections et 404 (BO12.2), robots (BO12.3), données structurées (BO12.4). -#}
{% extends 'admin/base.html.twig' %}
{% set active_module = 'seo' %}
{% set can_edit = is_granted('admin.seo.edit') %}
{% block title %}{{ tabs[tab] }} — SEO{% endblock %}
{% block body %}
    {{ include('admin/_page_header.html.twig', {title: 'SEO', crumbs: ['Contenus'], subtitle: 'Balises, redirections, sitemaps et données structurées'}) }}
    <nav class="tm-admin-tabs" aria-label="Sections SEO">
        {% for key, label in tabs %}
            <a class="tm-admin-tab{{ key == tab ? ' is-active' }}" href="{{ path('admin_seo', {onglet: key}) }}"{% if key == tab %} aria-current="page"{% endif %}>{{ label }}</a>
        {% endfor %}
    </nav>

    {% if tab == 'gabarits' %}
        <p class="tm-seo-help">Laissez un champ vide pour garder le texte par défaut de la page. Une variable sans valeur est retirée. Le title idéal fait moins de 60 caractères, la description moins de 155.</p>
        <div class="tm-seo-grid">
            {% for type, def in types %}
                {% set tpl = templates[type] ?? {title: null, description: null} %}
                <section class="tm-admin-panel" aria-labelledby="tpl-{{ type }}">
                    <h2 class="tm-card-title" id="tpl-{{ type }}">{{ def.label }}</h2>
                    <form method="post" action="{{ path('admin_seo_template', {type: type}) }}" class="tm-seo-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin_seo_template_' ~ type) }}">
                        <fieldset {{ can_edit ? '' : 'disabled' }}>
                            <div class="tm-field"><label class="tm-field__label" for="t_{{ type }}">Title</label>
                                <div class="tm-field__control"><input class="tm-field__input" id="t_{{ type }}" name="title" value="{{ tpl.title }}" maxlength="200"></div></div>
                            <div class="tm-field"><label class="tm-field__label" for="d_{{ type }}">Description</label>
                                <div class="tm-field__control"><textarea class="tm-field__input tm-field__textarea" id="d_{{ type }}" name="description" rows="2" maxlength="320">{{ tpl.description }}</textarea></div></div>
                            <p class="tm-caption">Variables : {{ def.variables|join(', ') }}</p>
                            {% if can_edit %}<twig:Button type="submit" variant="secondary">Enregistrer</twig:Button>{% endif %}
                        </fieldset>
                    </form>
                </section>
            {% endfor %}
        </div>

    {% elseif tab == 'surcharges' %}
        <section class="tm-admin-panel" aria-labelledby="ovr-title">
            <h2 class="tm-card-title" id="ovr-title">Surcharges page par page</h2>
            <p class="tm-seo-help">Remplace le title et / ou la description d’une adresse précise, ou la retire de l’indexation (noindex).</p>
            {% if overrides is not empty %}
                <div class="tm-admin-table-wrap"><table class="tm-admin-table">
                    <thead><tr><th scope="col">Adresse</th><th scope="col">Title</th><th scope="col">Description</th><th scope="col">Indexation</th>{% if can_edit %}<th scope="col"><span class="tm-visually-hidden">Actions</span></th>{% endif %}</tr></thead>
                    <tbody>
                    {% for o in overrides %}
                        <tr>
                            <th scope="row"><a href="{{ o.path }}">{{ o.path }}</a></th>
                            <td>{{ o.title ?? '—' }}</td><td>{{ o.description ?? '—' }}</td><td>{{ o.noindex ? 'noindex' : 'par défaut' }}</td>
                            {% if can_edit %}<td><form method="post" action="{{ path('admin_seo_override') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_seo_override') }}"><input type="hidden" name="path" value="{{ o.path }}"><button class="tm-link-button tm-admin-danger" name="action" value="delete">Retirer<span class="tm-visually-hidden"> la surcharge de {{ o.path }}</span></button></form></td>{% endif %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table></div>
            {% endif %}
            {% if can_edit %}
                <form method="post" action="{{ path('admin_seo_override') }}" class="tm-seo-form tm-seo-form--inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_seo_override') }}">
                    <div class="tm-field"><label class="tm-field__label" for="o_path">Adresse (chemin)</label><div class="tm-field__control"><input class="tm-field__input" id="o_path" name="path" placeholder="/plombier/le-havre-76600" required maxlength="500"></div></div>
                    <div class="tm-field"><label class="tm-field__label" for="o_title">Title</label><div class="tm-field__control"><input class="tm-field__input" id="o_title" name="title" maxlength="200"></div></div>
                    <div class="tm-field"><label class="tm-field__label" for="o_desc">Description</label><div class="tm-field__control"><input class="tm-field__input" id="o_desc" name="description" maxlength="320"></div></div>
                    <label class="tm-check"><input class="tm-check__input" type="checkbox" name="noindex" value="1"><span>noindex</span></label>
                    <twig:Button type="submit" variant="secondary">Enregistrer</twig:Button>
                </form>
            {% endif %}
        </section>

    {% elseif tab == 'redirections' %}
        <section class="tm-admin-panel" aria-labelledby="red-title">
            <h2 class="tm-card-title" id="red-title">Redirections ({{ redirects.total }})</h2>
            <form method="get" action="{{ path('admin_seo') }}" class="tm-seo-form tm-seo-form--inline" role="search">
                <input type="hidden" name="onglet" value="redirections">
                <div class="tm-field"><label class="tm-field__label" for="r_q">Rechercher une adresse</label><div class="tm-field__control"><input class="tm-field__input" id="r_q" name="q" value="{{ search }}"></div></div>
                <twig:Button type="submit" variant="secondary">Filtrer</twig:Button>
            </form>
            {% if redirects.items is not empty %}
                <div class="tm-admin-table-wrap"><table class="tm-admin-table">
                    <thead><tr><th scope="col">Source</th><th scope="col">Cible</th><th scope="col">Code</th><th scope="col">Origine</th><th scope="col">Utilisations</th>{% if can_edit %}<th scope="col"><span class="tm-visually-hidden">Actions</span></th>{% endif %}</tr></thead>
                    <tbody>
                    {% for r in redirects.items %}
                        <tr>
                            <th scope="row">{{ r.source }}{{ r.prefix ? '*' }}</th><td><a href="{{ r.target }}">{{ r.target }}</a></td><td>{{ r.status }}</td><td>{{ r.origin }}</td><td>{{ r.hits }}</td>
                            {% if can_edit %}<td><form method="post" action="{{ path('admin_seo_redirect') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_seo_redirect') }}"><input type="hidden" name="id" value="{{ r.id }}"><button class="tm-link-button tm-admin-danger" name="action" value="delete">Supprimer<span class="tm-visually-hidden"> la redirection {{ r.source }}</span></button></form></td>{% endif %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table></div>
                {% if redirects.total > per_page %}{{ include('admin/_pagination.html.twig', {page: {page: page, pages: (redirects.total / per_page)|round(0, 'ceil'), perPage: per_page, total: redirects.total}, route: 'admin_seo', params: {onglet: 'redirections', q: search}}) }}{% endif %}
            {% else %}<p>Aucune redirection{{ search ? ' pour « ' ~ search ~ ' »' }}.</p>{% endif %}
            {% if can_edit %}
                <h3>Ajouter une redirection</h3>
                <form method="post" action="{{ path('admin_seo_redirect') }}" class="tm-seo-form tm-seo-form--inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_seo_redirect') }}">
                    <div class="tm-field"><label class="tm-field__label" for="r_source">Source</label><div class="tm-field__control"><input class="tm-field__input" id="r_source" name="source" value="{{ prefill.source }}" placeholder="/ancienne-adresse" required></div></div>
                    <div class="tm-field"><label class="tm-field__label" for="r_target">Cible</label><div class="tm-field__control"><input class="tm-field__input" id="r_target" name="target" value="{{ prefill.target }}" placeholder="/nouvelle-adresse" required></div></div>
                    <div class="tm-field"><label class="tm-field__label" for="r_status">Code</label><div class="tm-field__control"><select class="tm-field__input" id="r_status" name="status"><option value="301">301 (définitive)</option><option value="302">302 (temporaire)</option></select></div></div>
                    <twig:Button type="submit" name="action" value="save">Enregistrer</twig:Button>
                </form>
                <h3>Importer un fichier CSV</h3>
                <form method="post" action="{{ path('admin_seo_redirect') }}" enctype="multipart/form-data" class="tm-seo-form tm-seo-form--inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('admin_seo_redirect') }}">
                    <div class="tm-field"><label class="tm-field__label" for="r_csv">Fichier « source;cible;code » (code facultatif, 301 par défaut)</label><input id="r_csv" name="csv" type="file" accept=".csv,text/csv" required></div>
                    <twig:Button type="submit" variant="secondary" name="action" value="import">Importer</twig:Button>
                </form>
            {% endif %}
        </section>

    {% elseif tab == '404' %}
        <section class="tm-admin-panel" aria-labelledby="nf-title">
            <h2 class="tm-card-title" id="nf-title">Adresses introuvables les plus demandées</h2>
            {% if not_found is empty %}<p>Aucune erreur 404 enregistrée.</p>{% else %}
                <div class="tm-admin-table-wrap"><table class="tm-admin-table">
                    <thead><tr><th scope="col">Adresse</th><th scope="col">Occurrences</th><th scope="col">Dernière origine</th><th scope="col">Dernière fois</th><th scope="col">Suggestion</th>{% if can_edit %}<th scope="col"><span class="tm-visually-hidden">Actions</span></th>{% endif %}</tr></thead>
                    <tbody>
                    {% for n in not_found %}
                        <tr>
                            <th scope="row">{{ n.path }}</th><td>{{ n.hits }}</td><td>{{ n.last_referer ?? '—' }}</td><td>{{ n.last_seen_at|date('d/m/Y H:i', 'Europe/Paris') }}</td>
                            <td>{% if n.suggestion %}<a href="{{ n.suggestion }}">{{ n.suggestion }}</a>{% else %}—{% endif %}</td>
                            {% if can_edit %}<td class="tm-seo-actions">
                                <a href="{{ path('admin_seo', {onglet: 'redirections', source: n.path, cible: n.suggestion}) }}">Créer la redirection</a>
                                <form method="post" action="{{ path('admin_seo_not_found') }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_seo_not_found') }}"><input type="hidden" name="path" value="{{ n.path }}"><button class="tm-link-button">Ignorer<span class="tm-visually-hidden"> {{ n.path }}</span></button></form>
                            </td>{% endif %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table></div>
            {% endif %}
        </section>

    {% else %}
        <section class="tm-admin-panel" aria-labelledby="robots-title">
            <h2 class="tm-card-title" id="robots-title">robots.txt et données structurées</h2>
            <p class="tm-seo-help">Les règles de base (zones privées, lien vers le <a href="{{ path('content_sitemap_index') }}">sitemap</a>) sont toujours présentes ; hors production, le robots.txt interdit toute indexation. <a href="{{ path('content_robots') }}">Voir le robots.txt</a></p>
            <form method="post" action="{{ path('admin_seo_robots') }}" class="tm-seo-form">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_seo_robots') }}">
                <fieldset {{ can_edit ? '' : 'disabled' }}>
                    <div class="tm-field"><label class="tm-field__label" for="robots_extra">Lignes ajoutées au robots.txt (une par ligne)</label>
                        <div class="tm-field__control"><textarea class="tm-field__input tm-field__textarea" id="robots_extra" name="robots_extra" rows="4" placeholder="Disallow: /recherche?*tri=">{{ robots_extra }}</textarea></div></div>
                    <fieldset class="tm-seo-schemas"><legend>Données structurées publiées</legend>
                        {% for name, s in schemas %}<label class="tm-check"><input class="tm-check__input" type="checkbox" name="schema_{{ name }}" value="1"{% if s.enabled %} checked{% endif %}><span>{{ s.label }}</span></label>{% endfor %}
                    </fieldset>
                    {% if can_edit %}<twig:Button type="submit">Enregistrer</twig:Button>{% endif %}
                </fieldset>
            </form>
        </section>
    {% endif %}
{% endblock %}
