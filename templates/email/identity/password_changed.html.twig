{#- E-04 : mot de passe modifié. -#}
{% extends 'email/_layout.html.twig' %}
{% block content %}
    <p>Bonjour {{ first_name }},</p>
    <p>Le mot de passe de votre compte TrouveMoi a été modifié le {{ changed_at|date('d/m/Y à H:i', 'Europe/Paris') }}. Toutes les autres sessions ont été fermées.</p>
    <p><strong>Ce n’était pas vous ?</strong> Réinitialisez immédiatement votre mot de passe, puis contactez-nous.</p>
    {{ include('email/_button.html.twig', {href: reset_link, label: 'Réinitialiser mon mot de passe'}) }}
    <p style="color:{{ palette.muted }};">Besoin d’aide : <a href="{{ help_link }}" style="color:{{ palette.link }};">contactez le support</a>.</p>
{% endblock %}
