{#- E-05 : connexion depuis un nouvel appareil (RG-045). -#}
{% extends 'email/_layout.html.twig' %}
{% block content %}
    <p>Bonjour {{ first_name }},</p>
    <p>Une connexion à votre compte TrouveMoi a eu lieu le {{ logged_at|date('d/m/Y à H:i', 'Europe/Paris') }} depuis un appareil que nous ne connaissions pas : <strong>{{ device }}</strong>.</p>
    <p>C’était vous ? Aucune action n’est nécessaire.</p>
    <p><strong>Ce n’était pas vous ?</strong> Changez votre mot de passe sans attendre : toutes les sessions ouvertes seront fermées.</p>
    {{ include('email/_button.html.twig', {href: reset_link, label: 'Sécuriser mon compte'}) }}
{% endblock %}
