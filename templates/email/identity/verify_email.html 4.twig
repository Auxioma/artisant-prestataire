{#- E-01 (inscription) / confirmation d'une nouvelle adresse (A06). -#}
{% extends 'email/_layout.html.twig' %}
{% block content %}
    <p>Bonjour {{ first_name }},</p>
    {% if email_change %}
        <p>Vous avez demandé à utiliser cette adresse pour votre compte TrouveMoi. Confirmez-la pour terminer le changement.</p>
    {% else %}
        <p>Bienvenue sur TrouveMoi ! Confirmez votre adresse e-mail pour pouvoir déposer des demandes et échanger avec les professionnels.</p>
    {% endif %}
    {{ include('email/_button.html.twig', {href: link, label: email_change ? 'Confirmer ma nouvelle adresse' : 'Confirmer mon adresse'}) }}
    <p>Ce lien est valable {{ ttl_hours }} heures et ne peut servir qu’une fois.</p>
    <p style="color:{{ palette.muted }};">Vous n’êtes pas à l’origine de cette demande ? Ignorez simplement cet e-mail : rien ne sera modifié.</p>
{% endblock %}
