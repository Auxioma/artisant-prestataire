{#- Bouton d'appel à l'action (couleurs : voir email/_layout.html.twig). Paramètres : href, label. -#}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px 0;"><tr>
    <td style="border-radius:999px;background:#ff7900;"><a href="{{ href }}" style="display:inline-block;padding:12px 24px;font-weight:600;font-size:15px;color:#001568;text-decoration:none;border-radius:999px;">{{ label }}</a></td>
</tr></table>
<p style="font-size:13px;line-height:20px;color:#5b6b82;">Si le bouton ne fonctionne pas, copiez ce lien dans votre navigateur :<br><a href="{{ href }}" style="color:#0057b8;word-break:break-all;">{{ href }}</a></p>
