{#- Champ mot de passe avec bouton « Afficher » (contrôleur password) ; variables : id, name, label, autocomplete, error. -#}
<div class="tm-field{{ error ? ' tm-field--error' }}" data-controller="password">
    <label class="tm-field__label" for="{{ id }}">{{ label }}<abbr class="tm-field__required" title="obligatoire">*</abbr></label>
    <div class="tm-field__control">
        <twig:Icon name="lock" size="sm" class="tm-icon--inherit" />
        <input class="tm-field__input" id="{{ id }}" name="{{ name }}" type="password" autocomplete="{{ autocomplete }}" required maxlength="128" data-password-target="input"{% if error %} aria-invalid="true" aria-describedby="{{ id }}_error"{% endif %}>
        <button type="button" class="tm-field__toggle" data-action="password#toggle" data-password-target="toggle" aria-controls="{{ id }}" aria-pressed="false" aria-label="Afficher le mot de passe">
            <twig:Icon name="eye" size="sm" class="tm-icon--inherit" data-password-target="showIcon" />
            <twig:Icon name="eyeOff" size="sm" class="tm-icon--inherit" data-password-target="hideIcon" hidden />
        </button>
    </div>
    {% if error %}<p class="tm-field__error" id="{{ id }}_error">{{ error }}</p>{% endif %}
</div>
