<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Nonce lu par Turbo pour la <style> de sa barre de progression (CSP sans unsafe-inline) #}
        <meta name="csp-nonce" content="{{ csp_nonce('style') }}">
        <title>{% block title %}TrouveMoi.com — Artisans & Prestataires{% endblock %}</title>
        {% block meta %}{% endblock %}
        {# CDC §2.2 : préchargement des graisses 400 et 600 #}
        <link rel="preload" href="{{ asset('fonts/poppins/poppins-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/poppins/poppins-latin-600-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        {# Feuille de styles unique découpée en couches (@layer) : l'ordre des liens fixe l'ordre des couches. #}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/button.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/form.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/badge.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/toast.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/modal.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/stepper.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/feedback.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/credit-gauge.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/card-artisan.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/switch.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/components/cookie-consent.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/layout/header.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/layout/breadcrumb.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/layout/footer.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/pages/auth.css') }}">
        {# Styles Live Component chargés ici (et non auto-importés en JS) : même raison CSP que ci-dessus. #}
        <link rel="stylesheet" href="{{ asset('@symfony/ux-live-component/live.min.css') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {# Importmap inline : nonce CSP obligatoire (pas d'unsafe-inline, cadrage §5.4) #}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce('script')}) }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="tm-skip-link" href="#contenu">Aller au contenu</a>
        {# CMP placée en tête de document : atteignable au clavier dès l'arrivée (CDC §3.2) #}
        <twig:CookieConsent />
        {% block header %}<twig:Header variant="{{ header_variant ?? 'visitor' }}" active="{{ active_nav ?? null }}" />{% endblock %}
        <main id="contenu" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
        {% block footer %}<twig:Footer />{% endblock %}
        <twig:ToastRegion />
    </body>
</html>
