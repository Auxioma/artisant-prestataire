<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}TrouveMoi.com — Artisans & Prestataires{% endblock %}</title>
        {% block meta %}{% endblock %}
        {# CDC §2.2 : préchargement des graisses 400 et 600 #}
        <link rel="preload" href="{{ asset('fonts/poppins/poppins-latin-400-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="preload" href="{{ asset('fonts/poppins/poppins-latin-600-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {# Importmap inline : nonce CSP obligatoire (pas d'unsafe-inline, cadrage §5.4) #}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce('script')}) }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="tm-skip-link" href="#contenu">Aller au contenu</a>
        {% block header %}{% endblock %}
        <main id="contenu" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
        {% block footer %}{% endblock %}
        <twig:ToastRegion />
    </body>
</html>
