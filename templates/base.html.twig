<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {# Nonce lu par Turbo pour la <style> de sa barre de progression (CSP sans unsafe-inline) #}
        <meta name="csp-nonce" content="{{ csp_nonce('style') }}">
        {% set seo_override = tm_seo_override() %}
        {# Titre déjà échappé : rendu du bloc `title` (échappé par Twig) ou surcharge BO12.1 échappée ici. |raw sans risque. #}
        {% set page_title = seo_override and seo_override.title ? seo_override.title|e : (block('title') is defined ? block('title')|trim : 'TrouveMoi.com — Artisans &amp; Prestataires') %}
        <title>{{ page_title|raw }}</title>
        {% block meta %}{% endblock %}
        {% block seo %}{{ include('_seo_head.html.twig', {title: page_title}) }}{% endblock %}
        {{ include('_head_assets.html.twig') }}
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {# Importmap inline : nonce CSP obligatoire (pas d'unsafe-inline, cadrage §5.4) #}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce('script')}) }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="tm-skip-link" href="#contenu">Aller au contenu</a>
        {# CMP placée en tête de document : atteignable au clavier dès l'arrivée (CDC §3.2) #}
        <twig:CookieConsent />
        {# ADR-0013 : bandeau persistant pendant une connexion assistée par un super-admin #}
        {% set impersonation = tm_impersonation() %}
        {% if impersonation %}
            <div class="tm-impersonation" role="status">
                <twig:Icon name="eye" size="sm" class="tm-icon--inherit" />
                <p>Connexion assistée : {{ impersonation.adminName }} agit dans ce compte jusqu’à {{ impersonation.expiresAt|date('H:i', 'Europe/Paris') }}. Paiements, abonnement et sécurité du compte sont bloqués ; toutes les actions sont journalisées.</p>
                <form method="post" action="{{ path('identity_impersonation_end') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('impersonation_end') }}">
                    <button type="submit" class="tm-impersonation__end">Terminer</button>
                </form>
            </div>
        {% endif %}
        {# Variante d'en-tête : imposée par la page (tunnel…), sinon selon le profil connecté #}
        {% set header_variant = header_variant ?? (app.user is null ? 'visitor' : (is_granted('ROLE_ARTISAN') ? 'artisan' : 'client')) %}
        {% block header %}<twig:Header variant="{{ header_variant }}" active="{{ active_nav ?? null }}" accountName="{{ app.user ? app.user.userIdentifier : null }}" unreadNotifications="{{ app.user and app.user.id is defined ? tm_unread_notifications(app.user.id) : 0 }}" :credits="header_variant == 'artisan' ? tm_artisan_credits() : null" />{% endblock %}
        {% if header_variant != 'tunnel' %}<twig:EmailVerificationBanner />{% endif %}
        {# A04 : événement « login » émis une fois, sur la première page après connexion (consentement requis) #}
        {% set login_method = app.request.hasPreviousSession ? app.session.remove('identity.login_track') : null %}
        {% if login_method %}<div hidden data-controller="analytics" data-analytics-auto-event-value="login" data-analytics-auto-type-value="{{ login_method }}"></div>{% endif %}
        <main id="contenu" tabindex="-1">
            {% block body %}{% endblock %}
        </main>
        {% block footer %}<twig:Footer />{% endblock %}
        <twig:ToastRegion />
    </body>
</html>
