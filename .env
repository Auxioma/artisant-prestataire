# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=redis://localhost:6379
###< symfony/messenger ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=null://null
# Expéditeur des e-mails transactionnels (sous-domaine d'envoi dédié en production, CDC §6 : SPF, DKIM, DMARC)
MAILER_SENDER="TrouveMoi <ne-pas-repondre@trouvemoi.com>"
# Boîte du support : alertes des messages du formulaire de contact (P16, I-03)
SUPPORT_INBOX=support@trouvemoi.com
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://trouvemoi:trouvemoi@127.0.0.1:5432/trouvemoi?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> trouvemoi ###
# Valeurs de développement uniquement. En production : coffre de secrets Symfony (secrets:set), jamais dans le dépôt.
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=tm_sess
TRUSTED_PROXIES=
###< trouvemoi ###

###> search (ADR-0004) ###
# Clés : en production via `bin/console secrets:set` (MEILISEARCH_SEARCH_KEY en lecture seule, MEILISEARCH_ADMIN_KEY pour l'indexation).
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_SEARCH_KEY=
MEILISEARCH_ADMIN_KEY=
MEILISEARCH_INDEX_PREFIX=tm_
###< search ###

###> services tiers (T-115) ###
# Clés réelles en production via `bin/console secrets:set` — jamais dans le dépôt.
INSEE_SIRENE_API_KEY=
# Clés de test publiques de Cloudflare (toujours valides) : à remplacer par les clés du site en production.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
###< services tiers ###

###> stockage (ADR-0008) ###
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=eu-west-3
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_QUARANTINE=trouvemoi-quarantine
S3_BUCKET_DOCUMENTS=trouvemoi-documents
CLAMAV_DSN=tcp://127.0.0.1:3310
# Clés maîtresses de chiffrement des justificatifs : « id:base64(32 octets);… ». Clé NULLE de développement
# uniquement (refusée en production) ; en production : `bin/console secrets:set STORAGE_KEKS` (voir README).
STORAGE_KEKS=dev-1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
STORAGE_KEK_CURRENT=dev-1

###< stockage ###

# Back-office (ADR-0013) : hôte réservé au back-office en production (ex. admin.trouvemoi.com) ; vide = tout hôte (dev).
ADMIN_HOST=

###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
###< symfony/brevo-mailer ###
