<?xml version="1.0" encoding="UTF-8"?>
<!-- Administration — comptes de l'équipe (BO14, ADR-0013), distincts des comptes clients et artisans. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Administration\Domain\Admin\AdminUser" table="admin_user" schema="admin">
        <id name="id" type="guid" column="id"/>
        <field name="email" type="string" length="254" unique="true"/>
        <field name="name" type="string" length="80"/>
        <field name="role" type="string" length="20" enum-type="App\Administration\Domain\Admin\AdminRole"/>
        <field name="status" type="string" length="10" enum-type="App\Administration\Domain\Admin\AdminStatus"/>
        <field name="passwordHash" type="string" length="255" column="password_hash" nullable="true"/>
        <field name="totpSecret" type="string" length="255" column="totp_secret" nullable="true"/>
        <field name="backupCodes" type="json" column="backup_codes">
            <options><option name="jsonb">true</option></options>
        </field>
        <field name="invitationTokenHash" type="string" length="64" column="invitation_token_hash" nullable="true"/>
        <field name="invitationExpiresAt" type="datetimetz_immutable" column="invitation_expires_at" nullable="true"/>
        <field name="invitedBy" type="guid" column="invited_by" nullable="true"/>
        <field name="activatedAt" type="datetimetz_immutable" column="activated_at" nullable="true"/>
        <field name="lastLoginAt" type="datetimetz_immutable" column="last_login_at" nullable="true"/>
        <field name="createdAt" type="datetimetz_immutable" column="created_at"/>
        <field name="updatedAt" type="datetimetz_immutable" column="updated_at"/>
        <field name="version" type="integer" version="true"/>
    </entity>
</doctrine-mapping>
